options:
  parameters:
    alias: ''
    author: null
    catch_exceptions: 'True'
    comment: ''
    copyright: null
    description: null
    gen_linking: dynamic
    generate_options: no_gui
    generator_class_name: PythonNoGuiGenerator
    generator_module: gnuradio.grc.workflows.python_nogui
    hier_block_src_path: null
    id: triple_tone
    max_nouts: '0'
    output_language: python
    realtime_scheduling: ''
    run_command: '{python} -u {filename}'
    run_options: prompt
    thread_safe_setters: ''
    title: null
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: out
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: ''
    file: output.dat
    type: float
    unbuffered: 'False'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: src
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.25'
    comment: ''
    freq: '1000'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: thr
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: triple
  id: epy_block
  parameters:
    _source_code: "\"\"\"Multiplies every sample by a constant gain.\"\"\"\n\nimport\
      \ numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    \"\
      \"\"Multiplies every sample by a constant gain.\"\"\"\n\n    def __init__(self,\
      \ gain=3.0):\n        gr.sync_block.__init__(self, name=\"Triple Gain\", in_sig=[np.float32],\
      \ out_sig=[np.float32])\n        self.gain = gain\n\n    def work(self, input_items,\
      \ output_items):\n        output_items[0][:] = input_items[0] * self.gain\n\
      \        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    comment: ''
    gain: '3.0'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Triple Gain', 'blk', [('gain', '3.0')], [('0', 'float', 1)], [('0',
      'float', 1)], 'Multiplies every sample by a constant gain.', ['gain'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled

connections:
- [src, '0', thr, '0']
- [thr, '0', triple, '0']
- [triple, '0', out, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
