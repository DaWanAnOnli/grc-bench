options:
  parameters:
    id: rewire_tone
    generate_options: no_gui
    output_language: python
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: '32000'
- name: src
  id: analog_sig_source_x
  parameters:
    type: float
    samp_rate: samp_rate
    waveform: analog.GR_COS_WAVE
    freq: '1000'
    amp: '0.5'
- name: gain
  id: blocks_multiply_const_xx
  parameters:
    type: float
    const: '1'
- name: out
  id: blocks_file_sink
  parameters:
    type: float
    file: output.dat
- name: spare
  id: blocks_null_sink
  parameters:
    type: float
  states:
    state: enabled
connections:
- - src
  - '0'
  - gain
  - '0'
- - gain
  - '0'
  - out
  - '0'
- - gain
  - '0'
  - spare
  - '0'
metadata:
  file_format: 1
