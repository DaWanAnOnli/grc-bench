#!/usr/bin/env bash
# GRC-Bench entry point. Run inside WSL from this folder:   ./gb <command> [args]
# From Windows:  wsl -e bash -lc "cd '/mnt/c/<path to>/grc-bench' && ./gb help"
#
# Uses GRC-Agent's own virtual environment read-only (it already has GNU Radio via system
# site-packages, numpy, scipy, pyyaml, pytest, jsonschema, tiktoken and pydantic-ai), so the
# benchmark runs on exactly the library versions the pinned agent uses.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="${GRC_AGENT_REPO:-$HOME/grc-agent}/.venv/bin/python"
export PYTHONPATH="$HERE/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1                       # never write __pycache__ (here or in ~/grc-agent)
export GRC_BENCH_CACHE="${GRC_BENCH_CACHE:-$HOME/grc-bench-cache}"
export GRC_BENCH_WORK="${GRC_BENCH_WORK:-$HOME/grc-bench-work}"
export TIKTOKEN_CACHE_DIR="$GRC_BENCH_CACHE/tiktoken"   # cl100k file cached for offline use
export QT_QPA_PLATFORM=offscreen
exec "$PY" -m grcbench "$@"
