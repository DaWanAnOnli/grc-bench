options:
    parameters:
        alias: ''
        author: null
        catch_exceptions: 'True'
        comment: ''
        copyright: null
        description: null
        gen_linking: dynamic
        generate_options: no_gui
        generator_class_name: PythonNoGuiGenerator
        generator_module: gnuradio.grc.workflows.python_nogui
        hier_block_src_path: '.:'
        id: sawtooth_peaks
        max_nouts: '0'
        output_language: python
        realtime_scheduling: ''
        run_command: '{python} -u {filename}'
        run_options: prompt
        thread_safe_setters: ''
        title: null
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
blocks:
-   name: alpha
    id: variable
    parameters:
        comment: ''
        value: '0.01'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: factor
    id: variable
    parameters:
        comment: ''
        value: '0.2'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: lookahead
    id: variable
    parameters:
        comment: ''
        value: int(samp_rate/saw_freq/1.1)
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: offset
    id: variable
    parameters:
        comment: ''
        value: '0.25'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: samp_rate
    id: variable
    parameters:
        comment: ''
        value: '48000'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: saw_freq
    id: variable
    parameters:
        comment: ''
        value: '400'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: analog_sig_source_x_0
    id: analog_sig_source_x
    parameters:
        affinity: ''
        alias: ''
        amp: '1.5'
        comment: ''
        freq: saw_freq
        maxoutbuf: '0'
        minoutbuf: '0'
        offset: offset
        phase: '0'
        samp_rate: samp_rate
        showports: 'False'
        type: float
        waveform: analog.GR_SAW_WAVE
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: blocks_char_to_float_0
    id: blocks_char_to_float
    parameters:
        affinity: ''
        alias: ''
        comment: ''
        maxoutbuf: '0'
        minoutbuf: '0'
        scale: '1'
        vlen: '1'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: blocks_file_sink_0
    id: blocks_file_sink
    parameters:
        affinity: ''
        alias: ''
        append: 'False'
        comment: ''
        file: peaks.dat
        type: float
        unbuffered: 'False'
        vlen: '1'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: blocks_file_sink_1
    id: blocks_file_sink
    parameters:
        affinity: ''
        alias: ''
        append: 'False'
        comment: ''
        file: average.dat
        type: float
        unbuffered: 'False'
        vlen: '1'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: blocks_peak_detector2_fb_0
    id: blocks_peak_detector2_fb
    parameters:
        affinity: ''
        alias: ''
        alpha: alpha
        comment: ''
        look_ahead: lookahead
        maxoutbuf: '0'
        minoutbuf: '0'
        threshold_factor_rise: factor
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
connections:
-   - analog_sig_source_x_0
    - '0'
    - blocks_peak_detector2_fb_0
    - '0'
-   - blocks_char_to_float_0
    - '0'
    - blocks_file_sink_0
    - '0'
-   - blocks_peak_detector2_fb_0
    - '0'
    - blocks_char_to_float_0
    - '0'
-   - blocks_peak_detector2_fb_0
    - '1'
    - blocks_file_sink_1
    - '0'
metadata:
    file_format: 1
    grc_version: 3.10.12.0
