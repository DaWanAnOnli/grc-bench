options:
  parameters:
    alias: ''
    author: null
    catch_exceptions: 'True'
    comment: ''
    copyright: null
    description: null
    gen_linking: dynamic
    generate_options: no_gui
    generator_class_name: PythonNoGuiGenerator
    generator_module: gnuradio.grc.workflows.python_nogui
    hier_block_src_path: '.:'
    id: soft_limited_tone
    max_nouts: '0'
    output_language: python
    realtime_scheduling: ''
    run_command: '{python} -u {filename}'
    run_options: prompt
    thread_safe_setters: ''
    title: null
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: clean_sink
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: ''
    file: clean_tone.dat
    type: float
    unbuffered: 'False'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: hpf
  id: high_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: ''
    cutoff_freq: '300'
    decim: '1'
    gain: '1'
    interp: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fir_filter_fff
    width: '200'
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: limiter
  id: epy_block
  parameters:
    _source_code: "\"\"\"Soft limiter: tanh(drive * x) / tanh(drive), so that +-1\
      \ stays +-1 and larger inputs saturate softly.\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    \"\"\"Soft limiter\
      \ with an adjustable drive.\"\"\"\n\n    def __init__(self, drive=2.5):\n  \
      \      gr.sync_block.__init__(self, name=\"Soft Limiter\", in_sig=[np.float32],\
      \ out_sig=[np.float32])\n        self.drive = float(drive)\n\n    def work(self,\
      \ input_items, output_items):\n        output_items[0][:] = np.tanh(self.drive\
      \ * input_items[0]) / np.tanh(self.drive)\n        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    comment: ''
    drive: '2.5'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Soft Limiter', 'blk', [('drive', '2.5')], [('0', 'float', 1)], [('0',
      'float', 1)], 'Soft limiter with an adjustable drive.', ['drive'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: tone
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.4'
    comment: ''
    freq: '1200'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0.75'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled

connections:
- [hpf, '0', limiter, '0']
- [limiter, '0', clean_sink, '0']
- [tone, '0', hpf, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
