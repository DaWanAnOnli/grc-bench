options:
    parameters:
        alias: ''
        author: null
        catch_exceptions: 'True'
        comment: ''
        copyright: null
        description: null
        gen_linking: dynamic
        generate_options: no_gui
        generator_class_name: PythonNoGuiGenerator
        generator_module: gnuradio.grc.workflows.python_nogui
        hier_block_src_path: '.:'
        id: nbfm_loopback
        max_nouts: '0'
        output_language: python
        realtime_scheduling: ''
        run_command: '{python} -u {filename}'
        run_options: prompt
        thread_safe_setters: ''
        title: null
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
blocks:
-   name: audio_rate
    id: variable
    parameters:
        comment: ''
        value: '8000'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: deviation
    id: variable
    parameters:
        comment: ''
        value: '5000'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: rx_scale
    id: variable
    parameters:
        comment: ''
        value: '5000'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: samp_rate
    id: variable
    parameters:
        comment: ''
        value: '40000'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: audio_lpf
    id: low_pass_filter
    parameters:
        affinity: ''
        alias: ''
        beta: '6.76'
        comment: ''
        cutoff_freq: '3000'
        decim: int(samp_rate/audio_rate)
        gain: '1'
        interp: '1'
        maxoutbuf: '0'
        minoutbuf: '0'
        samp_rate: samp_rate
        type: fir_filter_fff
        width: '1000'
        win: window.WIN_HAMMING
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: fm_demod
    id: analog_quadrature_demod_cf
    parameters:
        affinity: ''
        alias: ''
        comment: ''
        gain: samp_rate/(2*math.pi*rx_scale)
        maxoutbuf: '0'
        minoutbuf: '0'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: fm_iq
    id: blocks_file_sink
    parameters:
        affinity: ''
        alias: ''
        append: 'False'
        comment: ''
        file: fm_iq.dat
        type: complex
        unbuffered: 'False'
        vlen: '1'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: fm_mod
    id: analog_frequency_modulator_fc
    parameters:
        affinity: ''
        alias: ''
        comment: ''
        maxoutbuf: '0'
        minoutbuf: '0'
        sensitivity: 2*math.pi*deviation/samp_rate
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: recovered
    id: blocks_file_sink
    parameters:
        affinity: ''
        alias: ''
        append: 'False'
        comment: ''
        file: recovered.dat
        type: float
        unbuffered: 'False'
        vlen: '1'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: tone
    id: analog_sig_source_x
    parameters:
        affinity: ''
        alias: ''
        amp: '1'
        comment: ''
        freq: '1200'
        maxoutbuf: '0'
        minoutbuf: '0'
        offset: '0'
        phase: '0'
        samp_rate: audio_rate
        showports: 'False'
        type: float
        waveform: analog.GR_COS_WAVE
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: upsample
    id: rational_resampler_xxx
    parameters:
        affinity: ''
        alias: ''
        comment: ''
        decim: '1'
        fbw: '0'
        interp: int(samp_rate/audio_rate)
        maxoutbuf: '0'
        minoutbuf: '0'
        taps: '[]'
        type: fff
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
connections:
-   - audio_lpf
    - '0'
    - recovered
    - '0'
-   - fm_demod
    - '0'
    - audio_lpf
    - '0'
-   - fm_mod
    - '0'
    - fm_demod
    - '0'
-   - fm_mod
    - '0'
    - fm_iq
    - '0'
-   - tone
    - '0'
    - upsample
    - '0'
-   - upsample
    - '0'
    - fm_mod
    - '0'
metadata:
    file_format: 1
    grc_version: 3.10.12.0
