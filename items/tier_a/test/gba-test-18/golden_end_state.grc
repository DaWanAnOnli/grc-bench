-   name: unwrap
    id: epy_block
    parameters:
        _source_code: "\"\"\"Unwraps a phase in -pi..pi into a continuous phase, keeping\
            \ its state between work() calls.\"\"\"\n\nimport numpy as np\nfrom gnuradio\
            \ import gr\n\n\nclass blk(gr.sync_block):\n    \"\"\"Phase unwrapper:\
            \ removes the 2*pi jumps of a wrapped phase.\"\"\"\n\n    def __init__(self):\n\
            \        gr.sync_block.__init__(self, name=\"Phase Unwrap\", in_sig=[np.float32],\
            \ out_sig=[np.float32])\n        self.last = None\n        self.offset\
            \ = 0.0\n\n    def work(self, input_items, output_items):\n        x =\
            \ input_items[0].astype(np.float64)\n        prev = x[0] if self.last\
            \ is None else self.last\n        d = np.diff(np.concatenate(([prev],\
            \ x)))\n        steps = np.cumsum(np.where(d < -np.pi, 2 * np.pi, np.where(d\
            \ > np.pi, -2 * np.pi, 0.0)))\n        output_items[0][:] = x + self.offset\
            \ + steps\n        self.offset += steps[-1]\n        self.last = x[-1]\n\
            \        return len(output_items[0])\n"
        affinity: ''
        alias: ''
        comment: ''
        maxoutbuf: '0'
        minoutbuf: '0'
    states:
        _io_cache: '(''Phase Unwrap'', ''blk'', [], [(''0'', ''float'', 1)], [(''0'',
            ''float'', 1)], ''Phase unwrapper: removes the 2*pi jumps of a wrapped
            phase.'', [])'
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 696
        - 412.0
        state: enabled
