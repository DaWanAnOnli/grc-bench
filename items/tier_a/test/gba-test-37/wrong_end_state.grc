    bus_source: false
    bus_structure: null
    state: enabled

connections:
- [clip, '0', added_sink, '0']
- [conj, '0', out, '0']
- [hilbert, '0', conj, '0']
- [throttle, '0', clip, '0']
- [throttle, '0', hilbert, '0']
- [throttle, '0', to_short, '0']
- [to_float, '0', out_b, '0']
- [to_short, '0', to_float, '0']
- [tone_1, '0', throttle, '0']

metadata:
