    maxoutbuf: '0'
    minoutbuf: '0'
    scale: '1000'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: tone_1
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.5'
    comment: ''
    freq: '9700'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_COS_WAVE
  states:
