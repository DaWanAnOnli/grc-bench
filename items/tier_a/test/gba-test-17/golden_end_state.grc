        - 928
        - 212.0
        state: enabled
-   name: dac_codes
    id: epy_block
    parameters:
        _source_code: "\"\"\"8-bit DAC codes: round(255 * x), limited to 0..255, output\
            \ as float.\"\"\"\n\nimport numpy as np\nfrom gnuradio import gr\n\n\n\
            class blk(gr.sync_block):\n    \"\"\"Converts samples in 0..1 to 8-bit\
            \ DAC codes.\"\"\"\n\n    def __init__(self):\n        gr.sync_block.__init__(self,\
            \ name=\"DAC Codes\", in_sig=[np.float32], out_sig=[np.float32])\n\n \
            \   def work(self, input_items, output_items):\n        output_items[0][:]\
            \ = np.clip(np.round(input_items[0] * 255.0), 0, 255)\n        return\
            \ len(output_items[0])\n"
        affinity: ''
        alias: ''
        comment: ''
        maxoutbuf: '0'
        minoutbuf: '0'
    states:
        _io_cache: ('DAC Codes', 'blk', [], [('0', 'float', 1)], [('0', 'float', 1)],
            'Converts samples in 0..1 to 8-bit DAC codes.', [])
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 696
        - 212.0
        state: enabled
