options:
    parameters:
        alias: ''
        author: null
        catch_exceptions: 'True'
        comment: ''
        copyright: null
        description: null
        gen_linking: dynamic
        generate_options: no_gui
        generator_class_name: PythonNoGuiGenerator
        generator_module: gnuradio.grc.workflows.python_nogui
        hier_block_src_path: '.:'
        id: downconverter
        max_nouts: '0'
        output_language: python
        realtime_scheduling: ''
        run_command: '{python} -u {filename}'
        run_options: prompt
        thread_safe_setters: ''
        title: null
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
blocks:
-   name: lo_freq
    id: variable
    parameters:
        comment: ''
        value: '8700'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: samp_rate
    id: variable
    parameters:
        comment: ''
        value: '48000'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: if_filter
    id: low_pass_filter
    parameters:
        affinity: ''
        alias: ''
        beta: '6.76'
        comment: ''
        cutoff_freq: '4000'
        decim: '1'
        gain: '1'
        interp: '1'
        maxoutbuf: '0'
        minoutbuf: '0'
        samp_rate: samp_rate
        type: fir_filter_fff
        width: '1000'
        win: window.WIN_HAMMING
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: if_sink
    id: blocks_file_sink
    parameters:
        affinity: ''
        alias: ''
        append: 'False'
        comment: ''
        file: if.dat
        type: float
        unbuffered: 'False'
        vlen: '1'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: lo
    id: analog_sig_source_x
    parameters:
        affinity: ''
        alias: ''
        amp: '1.0'
        comment: ''
        freq: lo_freq
        maxoutbuf: '0'
        minoutbuf: '0'
        offset: '0'
        phase: '0'
        samp_rate: samp_rate
        showports: 'False'
        type: float
        waveform: analog.GR_COS_WAVE
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: mixer
    id: blocks_multiply_xx
    parameters:
        affinity: ''
        alias: ''
        comment: ''
        maxoutbuf: '0'
        minoutbuf: '0'
        num_inputs: '2'
        type: float
        vlen: '1'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
-   name: rf
    id: analog_sig_source_x
    parameters:
        affinity: ''
        alias: ''
        amp: '0.8'
        comment: ''
        freq: '10700'
        maxoutbuf: '0'
        minoutbuf: '0'
        offset: '0'
        phase: '0'
        samp_rate: samp_rate
        showports: 'False'
        type: float
        waveform: analog.GR_COS_WAVE
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
connections:
-   - if_filter
    - '0'
    - if_sink
    - '0'
-   - lo
    - '0'
    - mixer
    - '1'
-   - mixer
    - '0'
    - if_filter
    - '0'
-   - rf
    - '0'
    - mixer
    - '0'
metadata:
    file_format: 1
    grc_version: 3.10.12.0
