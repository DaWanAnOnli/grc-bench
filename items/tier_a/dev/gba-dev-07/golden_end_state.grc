options:
    parameters:
        alias: ''
        author: null
        catch_exceptions: 'True'
        comment: ''
        copyright: null
        description: null
        gen_linking: dynamic
        generate_options: no_gui
        generator_class_name: PythonNoGuiGenerator
        generator_module: gnuradio.grc.workflows.python_nogui
        hier_block_src_path: '.:'
        id: rayleigh_phase
        max_nouts: '0'
        output_language: python
        realtime_scheduling: ''
        run_command: '{python} -u {filename}'
        run_options: prompt
        thread_safe_setters: ''
