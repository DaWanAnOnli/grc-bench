options:
  parameters:
    alias: ''
    author: null
    catch_exceptions: 'True'
    comment: ''
    copyright: null
    description: null
    gen_linking: dynamic
    generate_options: no_gui
    generator_class_name: PythonNoGuiGenerator
    generator_module: gnuradio.grc.workflows.python_nogui
    hier_block_src_path: '.:'
    id: rayleigh_envelope
    max_nouts: '0'
    output_language: python
    realtime_scheduling: ''
    run_command: '{python} -u {filename}'
    run_options: prompt
    thread_safe_setters: ''
    title: null
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: mag
  id: epy_block
  parameters:
    _source_code: "\"\"\"Magnitude of a complex stream.\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    \"\"\"Outputs |z|\
      \ for every complex input sample.\"\"\"\n\n    def __init__(self):\n       \
      \ gr.sync_block.__init__(self, name=\"Complex Magnitude\", in_sig=[np.complex64],\
      \ out_sig=[np.float32])\n\n    def work(self, input_items, output_items):\n\
      \        output_items[0][:] = np.abs(input_items[0])\n        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Complex Magnitude', 'blk', [], [('0', 'complex', 1)], [('0', 'float',
      1)], 'Outputs |z| for every complex input sample.', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: noise
  id: analog_noise_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.8'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_type: analog.GR_GAUSSIAN
    seed: '42'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: snk
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: ''
    file: envelope.dat
    type: float
    unbuffered: 'False'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: thr
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled

connections:
- [mag, '0', snk, '0']
- [noise, '0', thr, '0']
- [thr, '0', mag, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
