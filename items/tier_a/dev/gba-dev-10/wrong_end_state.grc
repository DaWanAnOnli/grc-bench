  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: tag0
  id: variable_tag_object
  parameters:
    comment: ''
    key: pmt.intern("key0")
    offset: '0'
    src: pmt.intern("src")
