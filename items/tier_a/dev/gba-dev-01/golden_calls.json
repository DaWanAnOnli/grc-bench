{
 "calls": [
  {
   "args": {},
   "tool": "inspect_graph"
  },
  {
   "args": {
    "domain": "catalog",
    "k": 3,
    "query": "noise source gaussian complex"
   },
   "tool": "query_knowledge"
  },
  {
   "args": {
    "domain": "catalog",
    "k": 3,
    "query": "low pass filter cutoff transition"
   },
   "tool": "query_knowledge"
  },
  {
   "args": {
    "reason": "Set the sample rate to 48000 samples per second.",
    "update_params": [
     {
      "instance_name": "samp_rate",
      "params": {
       "value": "48000"
      }
     }
    ]
   },
   "tool": "change_graph"
  },
  {
   "args": {
    "add_blocks": [
     {
      "block_id": "analog_noise_source_x",
      "instance_name": "noise",
      "params": {
       "amp": "0.5",
       "noise_type": "analog.GR_GAUSSIAN",
       "type": "complex"
      }
     },
     {
      "block_id": "low_pass_filter",
      "instance_name": "band_limit",
      "params": {
       "cutoff_freq": "2000",
       "decim": "1",
       "gain": "1",
       "samp_rate": "samp_rate",
       "type": "fir_filter_ccf",
       "width": "500"
      }
     },
     {
      "block_id": "analog_sig_source_x",
      "instance_name": "lo",
      "params": {
       "amp": "1",
       "freq": "10000",
       "samp_rate": "samp_rate",
       "type": "complex"
      }
     },
     {
      "block_id": "blocks_multiply_xx",
      "instance_name": "shift",
      "params": {
       "type": "complex"
      }
     },
     {
      "block_id": "blocks_throttle2",
      "instance_name": "throttle",
      "params": {
       "samples_per_second": "samp_rate",
       "type": "complex"
      }
     },
     {
      "block_id": "blocks_file_sink",
      "instance_name": "out",
      "params": {
       "file": "shifted.dat",
       "type": "complex"
      }
     }
    ],
    "add_connections": [
     "noise:0->band_limit:0",
     "band_limit:0->shift:0",
     "lo:0->shift:1",
     "shift:0->throttle:0",
     "throttle:0->out:0"
    ],
    "reason": "Build the shifted noise band writing to shifted.dat."
   },
   "tool": "change_graph"
  },
  {
   "args": {},
   "tool": "inspect_graph"
  },
  {
   "args": {},
   "tool": "generate_python"
  },
  {
   "args": {},
   "tool": "save_graph"
  },
  {
   "args": {
    "action": "start",
    "stop_after_seconds": 2
   },
   "tool": "run_flowgraph"
  },
  {
   "args": {},
   "tool": "get_run_log"
  }
 ],
 "final_text": "I built and saved the flowgraph at 48 kHz: complex Gaussian noise (amplitude 0.5) goes through a 2 kHz Low Pass Filter, is multiplied by a complex 10 kHz tone, throttled and written to shifted.dat, so the band is centred on 10 kHz."
}
