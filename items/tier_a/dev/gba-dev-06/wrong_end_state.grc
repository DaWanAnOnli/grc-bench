options:
  parameters:
    alias: ''
    author: null
    catch_exceptions: 'True'
    comment: ''
    copyright: null
    description: null
    gen_linking: dynamic
    generate_options: no_gui
    generator_class_name: PythonNoGuiGenerator
    generator_module: gnuradio.grc.workflows.python_nogui
    hier_block_src_path: '.:'
    id: noise_limiter
    max_nouts: '0'
    output_language: python
    realtime_scheduling: ''
    run_command: '{python} -u {filename}'
    run_options: prompt
    thread_safe_setters: ''
    title: null
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: clip_out
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: ''
    file: clipped.dat
    type: float
    unbuffered: 'False'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: clips
  id: epy_block
  parameters:
    _source_code: "\"\"\"Clip detector: 1.0 where the input sits at either clip level,\
      \ else 0.0.\"\"\"\n\nimport numpy as np\nfrom gnuradio import gr\n\n\nclass\
      \ blk(gr.sync_block):\n    \"\"\"Marks the samples a limiter clipped.\"\"\"\n\
      \n    def __init__(self, level=0.784):\n        gr.sync_block.__init__(self,\
      \ name=\"Clip Detector\", in_sig=[np.float32], out_sig=[np.float32])\n     \
      \   self.level = float(level)\n\n    def work(self, input_items, output_items):\n\
      \        x = input_items[0]\n        output_items[0][:] = (np.abs(x) >= self.level\
      \ - 1e-6).astype(np.float32)\n        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    comment: ''
    level: '0.5'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Clip Detector', 'blk', [('level', '0.784')], [('0', 'float', 1)],
      [('0', 'float', 1)], 'Marks the samples a limiter clipped.', ['level'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: limiter
  id: analog_rail_ff
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    hi: '0.784'
    lo: '-0.784'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: noise_src
  id: analog_noise_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.4'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_type: analog.GR_GAUSSIAN
    seed: '7'
    type: float
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: sink_in
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: ''
    file: noise_in.dat
    type: float
    unbuffered: 'False'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: sink_out
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: ''
    file: limited.dat
    type: float
    unbuffered: 'False'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: throttle
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled

connections:
- [clips, '0', clip_out, '0']
- [limiter, '0', clips, '0']
- [limiter, '0', sink_out, '0']
- [noise_src, '0', throttle, '0']
- [throttle, '0', limiter, '0']
- [throttle, '0', sink_in, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
