options:
  parameters:
    alias: ''
    author: null
    catch_exceptions: 'True'
    comment: ''
    copyright: null
    description: null
    gen_linking: dynamic
    generate_options: no_gui
    generator_class_name: PythonNoGuiGenerator
    generator_module: gnuradio.grc.workflows.python_nogui
    hier_block_src_path: '.:'
    id: filter_taps
    max_nouts: '0'
    output_language: python
    realtime_scheduling: ''
    run_command: '{python} -u {filename}'
    run_options: prompt
    thread_safe_setters: ''
    title: null
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled

blocks:
- name: bp_high
  id: variable
  parameters:
    comment: ''
    value: '7250'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: bp_low
  id: variable
  parameters:
    comment: ''
    value: '3750'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: bp_taps
  id: variable_band_pass_filter_taps
  parameters:
    beta: '6.76'
    comment: ''
    gain: '1.0'
    high_cutoff_freq: bp_high
    low_cutoff_freq: bp_low
    samp_rate: samp_rate
    type: band_pass
    value: ''
    width: transition
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: br_taps
  id: variable_band_reject_filter_taps
  parameters:
    beta: '6.76'
    comment: ''
    gain: '1.0'
    high_cutoff_freq: bp_high
    low_cutoff_freq: bp_low
    samp_rate: samp_rate
    type: band_reject
    value: ''
    width: transition
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: cutoff_high
  id: variable
  parameters:
    comment: ''
    value: '3750'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: cutoff_low
  id: variable
  parameters:
    comment: ''
    value: '7250'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: hp_taps
  id: variable_high_pass_filter_taps
  parameters:
    beta: '6.76'
    comment: ''
    cutoff_freq: cutoff_low
    gain: '1.0'
    samp_rate: samp_rate
    value: ''
    width: transition
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: len_taps
  id: variable
  parameters:
    comment: ''
    value: len(lp_taps)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: lp_taps
  id: variable_low_pass_filter_taps
  parameters:
    beta: '6.76'
    comment: ''
    cutoff_freq: cutoff_high
    gain: '1.0'
    samp_rate: samp_rate
    value: ''
    width: transition
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: rrc_taps
  id: variable_rrc_filter_taps
  parameters:
    alpha: '0.25'
    comment: ''
    gain: '1.0'
    ntaps: 11*sps
    samp_rate: samp_rate
    sym_rate: sym_rate
    value: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: ''
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: sym_rate
  id: variable
  parameters:
    comment: ''
    value: samp_rate/sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
- name: transition
  id: variable
  parameters:
    comment: ''
    value: '500'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
