options:
  parameters: {id: gbf_test_68, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_4100
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-4100', amp: '0.6'}
- name: tone_2700
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-2700', amp: '0.25'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '2'}
- name: resampler_2
  id: rational_resampler_xxx
  parameters: {type: ccc, decim: '2'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: lpf
  id: fft_filter_xxx
  parameters: {type: ccf, taps: 'firdes.low_pass(1, samp_rate*2/1*1/2, 3400, 300)'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: filtered.dat}
- name: power
  id: blocks_complex_to_mag_squared
  parameters: {}
- name: average
  id: blocks_moving_average_xx
  parameters: {type: float, length: '500', scale: 1/500}
- name: to_db
  id: blocks_nlog10_ff
  parameters: {n: '10'}
- name: out_b
  id: blocks_file_sink
  parameters: {type: float, file: second_power_db.dat}
connections:
- [tone_4100, '0', sum_of_tones, '0']
- [tone_2700, '0', sum_of_tones, '1']
- [sum_of_tones, '0', resampler, '0']
- [resampler, '0', resampler_2, '0']
- [resampler_2, '0', conj, '0']
- [conj, '0', lpf, '0']
- [lpf, '0', out, '0']
- [lpf, '0', power, '0']
- [power, '0', average, '0']
- [average, '0', to_db, '0']
- [to_db, '0', out_b, '0']
metadata: {file_format: 1}
