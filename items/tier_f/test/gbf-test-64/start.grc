options:
  parameters: {id: gbf_test_64, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_6200
  id: analog_sig_source_x
  parameters: {type: complex, freq: '6200', amp: '0.5'}
- name: magnitude
  id: blocks_complex_to_mag
  parameters: {}
- name: to_db
  id: blocks_nlog10_ff
  parameters: {n: '20'}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: level_db.dat}
connections:
- [tone_6200, '0', magnitude, '0']
- [magnitude, '0', to_db, '0']
- [to_db, '0', out, '0']
metadata: {file_format: 1}
