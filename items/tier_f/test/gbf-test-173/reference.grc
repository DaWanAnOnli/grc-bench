options:
  parameters: {id: gbf_test_173, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_1
  id: analog_sig_source_x
  parameters: {type: float, freq: '3100', amp: '0.5'}
- name: fm_mod
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: 2*math.pi*1000/samp_rate}
- name: fm_demod
  id: analog_quadrature_demod_cf
  parameters: {gain: samp_rate/(2*math.pi*2000)}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '3', decim: '2'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: resampled.dat}
- name: magnitude
  id: blocks_complex_to_mag
  parameters: {}
- name: out_b
  id: blocks_file_sink
  parameters: {type: float, file: second_level.dat}
connections:
- [tone_1, '0', fm_mod, '0']
- [fm_mod, '0', fm_demod, '0']
- [fm_demod, '0', hilbert, '0']
- [hilbert, '0', resampler, '0']
- [resampler, '0', out, '0']
- [hilbert, '0', magnitude, '0']
- [magnitude, '0', out_b, '0']
metadata: {file_format: 1}
