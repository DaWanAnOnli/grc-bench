options:
  parameters: {id: gbf_test_98, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_7300
  id: analog_sig_source_x
  parameters: {type: complex, freq: '7300', amp: '0.4', showports: 'True'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 3000/samp_rate, taps: '[1.0]'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 5100})', period: '250'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat}
- name: power
  id: blocks_complex_to_mag_squared
  parameters: {}
- name: average
  id: blocks_moving_average_xx
  parameters: {type: float, length: '2000', scale: 1/2000}
- name: to_db
  id: blocks_nlog10_ff
  parameters: {n: '10'}
- name: out_b
  id: blocks_file_sink
  parameters: {type: float, file: second_power_db.dat}
connections:
- [channel, '0', conj, '0']
- [retune, strobe, tone_7300, cmd]
- [tone_7300, '0', throttle, '0']
- [throttle, '0', channel, '0']
- [conj, '0', out, '0']
- [conj, '0', power, '0']
- [power, '0', average, '0']
- [average, '0', to_db, '0']
- [to_db, '0', out_b, '0']
metadata: {file_format: 1}
