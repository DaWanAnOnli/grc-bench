options:
  parameters: {id: gbf_test_98, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_7300
  id: analog_sig_source_x
  parameters: {type: complex, freq: '7300', amp: '0.4', showports: 'True'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 3000/samp_rate, taps: '[1.0]'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 5100})', period: '250'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat}
connections:
- [channel, '0', conj, '0']
- [retune, strobe, tone_7300, cmd]
- [tone_7300, '0', throttle, '0']
- [throttle, '0', channel, '0']
- [conj, '0', out, '0']
metadata: {file_format: 1}
