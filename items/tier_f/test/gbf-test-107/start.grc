options:
  parameters: {id: gbf_test_107, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_2600
  id: analog_sig_source_x
  parameters: {type: float, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '2600', amp: '1',
    offset: '0'}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: fff, interp: '1', decim: '2', taps: '[]', fbw: '0'}
- name: resampler_2
  id: rational_resampler_xxx
  parameters: {type: fff, interp: '2', decim: '1', taps: '[]', fbw: '0'}
- name: to_short
  id: blocks_float_to_short
  parameters: {vlen: '1', scale: '1000'}
- name: to_float
  id: blocks_short_to_float_x
  parameters: {vlen: '1', scale: '1000'}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: quantized.dat, append: 'False', unbuffered: 'False', vlen: '1'}
connections:
- [tone_2600, '0', resampler, '0']
- [resampler, '0', resampler_2, '0']
- [resampler_2, '0', to_short, '0']
- [to_short, '0', to_float, '0']
- [to_float, '0', out, '0']
metadata: {file_format: 1}
