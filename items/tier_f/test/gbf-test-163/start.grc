options:
  parameters: {id: gbf_test_163, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: square
  id: analog_sig_source_x
  parameters: {type: float, samp_rate: samp_rate, waveform: analog.GR_SQR_WAVE, freq: '600', amp: '1',
    offset: '0'}
- name: lpf
  id: low_pass_filter
  parameters: {type: fir_filter_fff, decim: '1', gain: '1', samp_rate: samp_rate, cutoff_freq: '1200',
    width: '400', win: window.WIN_HAMMING, beta: '6.76'}
- name: to_short
  id: blocks_float_to_short
  parameters: {vlen: '1', scale: '1000'}
- name: to_float
  id: blocks_short_to_float_x
  parameters: {vlen: '1', scale: '1000'}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: quantized.dat, append: 'False', unbuffered: 'False', vlen: '1'}
connections:
- [square, '0', lpf, '0']
- [lpf, '0', to_short, '0']
- [to_short, '0', to_float, '0']
- [to_float, '0', out, '0']
metadata: {file_format: 1}
