options:
  parameters: {id: gbf_test_52, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_8400
  id: analog_sig_source_x
  parameters: {type: float, freq: '8400', amp: '0.8'}
- name: tone_700
  id: analog_sig_source_x
  parameters: {type: float, freq: '700', amp: '0.4'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 1250/samp_rate, taps: '[1.0]'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: (-1500)*2}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat}
connections:
- [tone_8400, '0', sum_of_tones, '0']
- [tone_700, '0', sum_of_tones, '1']
- [sum_of_tones, '0', hilbert, '0']
- [hilbert, '0', channel, '0']
- [channel, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', conj, '0']
- [conj, '0', out, '0']
metadata: {file_format: 1}
