options:
  parameters: {id: dac_test_v4, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: csrc
  id: analog_sig_source_x
  parameters: {type: complex, freq: '1250'}
- name: legacy_thr
  id: blocks_throttle
  parameters: {type: complex}
- name: re
  id: blocks_complex_to_real
  parameters: {}
- name: scale
  id: blocks_multiply_const_xx
  parameters: {type: float, const: '0.4'}
- name: lift
  id: blocks_add_const_vxx
  parameters: {type: float, const: '0.55'}
- name: snk
  id: blocks_file_sink
  parameters: {type: float, file: '''/tmp/'' + ''dac_test.dat'''}
connections:
- [csrc, '0', legacy_thr, '0']
- [legacy_thr, '0', re, '0']
- [re, '0', scale, '0']
- [scale, '0', lift, '0']
- [lift, '0', snk, '0']
metadata: {file_format: 1}
