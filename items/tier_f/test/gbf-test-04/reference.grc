options:
  parameters: {id: dac_test_signal, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: src
  id: analog_sig_source_x
  parameters: {type: float, freq: '1250'}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: float, const: '0.4'}
- name: offset
  id: blocks_add_const_vxx
  parameters: {type: float, const: '0.55'}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: dac_test.dat}
connections:
- [src, '0', gain, '0']
- [gain, '0', offset, '0']
- [offset, '0', out, '0']
metadata: {file_format: 1}
