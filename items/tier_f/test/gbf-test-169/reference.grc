options:
  parameters: {id: gbf_test_169, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_1
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-2800', amp: '0.4'}
- name: noise
  id: analog_noise_source_x
  parameters: {type: complex, amp: '0.1'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, decim: '4'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 1250/(samp_rate*1/4), taps: '[1.0]'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: resampler_2
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '3', decim: '2'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: resampled.dat}
connections:
- [tone_1, '0', sum_of_tones, '0']
- [noise, '0', sum_of_tones, '1']
- [sum_of_tones, '0', resampler, '0']
- [resampler, '0', channel, '0']
- [channel, '0', conj, '0']
- [conj, '0', resampler_2, '0']
- [resampler_2, '0', out, '0']
metadata: {file_format: 1}
