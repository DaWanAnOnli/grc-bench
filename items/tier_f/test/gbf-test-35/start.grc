options:
  parameters: {id: gbf_test_35, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_1200
  id: analog_sig_source_x
  parameters: {type: float, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '1200', amp: '0.5',
    offset: '0'}
- name: tone_3100
  id: analog_sig_source_x
  parameters: {type: float, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '3100', amp: '0.5',
    offset: '0'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float, num_inputs: '2'}
- name: hilbert
  id: hilbert_fc_x
  parameters: {num_taps: '65', win: window.WIN_HAMMING, beta: '6.76'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '4500', amp: '1',
    offset: '0'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex, num_inputs: '2'}
- name: lo_2
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '2000', amp: '1',
    offset: '0'}
- name: mixer_2
  id: blocks_multiply_xx
  parameters: {type: complex, num_inputs: '2'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: shifted.dat, append: 'False', unbuffered: 'False', vlen: '1'}
connections:
- [tone_1200, '0', sum_of_tones, '0']
- [tone_3100, '0', sum_of_tones, '1']
- [sum_of_tones, '0', hilbert, '0']
- [hilbert, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', mixer_2, '0']
- [lo_2, '0', mixer_2, '1']
- [mixer_2, '0', out, '0']
metadata: {file_format: 1}
