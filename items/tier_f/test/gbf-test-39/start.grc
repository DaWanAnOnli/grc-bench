options:
  parameters: {id: gbf_test_39, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_5400
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '5400', amp: '0.8',
    offset: '0', showports: 'True'}
- name: noise
  id: analog_noise_source_x
  parameters: {type: complex, noise_type: analog.GR_GAUSSIAN, amp: '0.05', seed: '0'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex, num_inputs: '2'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -1750/samp_rate, epsilon: '1.0', taps: '[1.0]', seed: '0',
    block_tags: 'False'}
- name: channel_2
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 3000/samp_rate, epsilon: '1.0', taps: '[1.0]', seed: '0',
    block_tags: 'False'}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 7600})', period: '100'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: complex, samples_per_second: samp_rate, ignoretag: 'True', maximum: '0.1', limit: auto,
    vlen: '1'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat, append: 'False', unbuffered: 'False', vlen: '1'}
connections:
- [noise, '0', sum_of_tones, '1']
- [sum_of_tones, '0', channel, '0']
- [channel, '0', channel_2, '0']
- [retune, strobe, tone_5400, cmd]
- [throttle, '0', sum_of_tones, '0']
- [channel_2, '0', out, '0']
metadata: {file_format: 1}
