options:
  parameters: {id: gbf_test_39, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_5400
  id: analog_sig_source_x
  parameters: {type: complex, freq: '5400', amp: '0.8', showports: 'True'}
- name: noise
  id: analog_noise_source_x
  parameters: {type: complex, amp: '0.05'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -1750/samp_rate, taps: '[1.0]'}
- name: channel_2
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 3000/samp_rate, taps: '[1.0]'}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 7600})', period: '100'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
connections:
- [noise, '0', sum_of_tones, '1']
- [sum_of_tones, '0', channel, '0']
- [channel, '0', channel_2, '0']
- [retune, strobe, tone_5400, cmd]
- [tone_5400, '0', throttle, '0']
- [throttle, '0', sum_of_tones, '0']
- [channel_2, '0', out, '0']
metadata: {file_format: 1}
