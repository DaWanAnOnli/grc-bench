options:
  parameters: {id: gbf_test_73, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_10400
  id: analog_sig_source_x
  parameters: {type: float, freq: '10400', amp: '0.8'}
- name: tone_600
  id: analog_sig_source_x
  parameters: {type: float, freq: '600', amp: '0.6'}
- name: tone_8600
  id: analog_sig_source_x
  parameters: {type: float, freq: '8600', amp: '0.5'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float, num_inputs: '3'}
- name: lpf
  id: low_pass_filter
  parameters: {type: fir_filter_fff, cutoff_freq: '4600', width: '400'}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: fff, interp: '2'}
- name: to_short
  id: blocks_float_to_short
  parameters: {scale: '10'}
- name: to_float
  id: blocks_short_to_float
  parameters: {scale: '10'}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: quantized.dat}
- name: fm_mod
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: 2*math.pi*1500/samp_rate}
- name: fm_demod
  id: analog_quadrature_demod_cf
  parameters: {gain: samp_rate/(2*math.pi*750)}
- name: out_b
  id: blocks_file_sink
  parameters: {type: float, file: second_recovered.dat}
- name: rate_limit
  id: blocks_throttle2
  parameters: {type: float, limit: auto}
connections:
- [tone_10400, '0', sum_of_tones, '0']
- [tone_600, '0', sum_of_tones, '1']
- [tone_8600, '0', sum_of_tones, '2']
- [sum_of_tones, '0', lpf, '0']
- [lpf, '0', resampler, '0']
- [resampler, '0', to_short, '0']
- [to_short, '0', to_float, '0']
- [to_float, '0', out, '0']
- [lpf, '0', fm_mod, '0']
- [fm_mod, '0', fm_demod, '0']
- [fm_demod, '0', rate_limit, '0']
- [rate_limit, '0', out_b, '0']
metadata: {file_format: 1}
