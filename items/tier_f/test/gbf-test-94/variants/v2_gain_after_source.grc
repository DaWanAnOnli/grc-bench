options:
  parameters: {id: gbf_test_94, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_6700
  id: analog_sig_source_x
  parameters: {type: float, freq: '6700'}
- name: tone_10000
  id: analog_sig_source_x
  parameters: {type: float, freq: '10000', amp: '0.5'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float}
- name: lpf
  id: low_pass_filter
  parameters: {type: fir_filter_fff, cutoff_freq: '8350', width: '300'}
- name: fm_mod
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: 2*math.pi*1500/samp_rate}
- name: fm_demod
  id: analog_quadrature_demod_cf
  parameters: {gain: samp_rate/(2*math.pi*750)}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: fff, interp: '3', decim: '2'}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: resampled.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: float, const: '0.4'}
connections:
- [tone_10000, '0', sum_of_tones, '1']
- [sum_of_tones, '0', lpf, '0']
- [lpf, '0', fm_mod, '0']
- [fm_mod, '0', fm_demod, '0']
- [fm_demod, '0', resampler, '0']
- [resampler, '0', out, '0']
- [tone_6700, '0', gain, '0']
- [gain, '0', sum_of_tones, '0']
metadata: {file_format: 1}
