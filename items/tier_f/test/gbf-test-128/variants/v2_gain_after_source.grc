options:
  parameters: {id: gbf_test_128, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_10600
  id: analog_sig_source_x
  parameters: {type: float, freq: '10600'}
- name: to_short
  id: blocks_float_to_short
  parameters: {scale: '1000'}
- name: to_float
  id: blocks_short_to_float
  parameters: {scale: '1000'}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: quantized.dat}
- name: to_short_2
  id: blocks_float_to_short
  parameters: {scale: '100'}
- name: to_float_2
  id: blocks_short_to_float
  parameters: {scale: '100'}
- name: out_b
  id: blocks_file_sink
  parameters: {type: float, file: second_quantized.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: float, const: '0.6'}
connections:
- [to_short, '0', to_float, '0']
- [to_float, '0', out, '0']
- [to_float, '0', to_short_2, '0']
- [to_short_2, '0', to_float_2, '0']
- [to_float_2, '0', out_b, '0']
- [tone_10600, '0', gain, '0']
- [gain, '0', to_short, '0']
metadata: {file_format: 1}
