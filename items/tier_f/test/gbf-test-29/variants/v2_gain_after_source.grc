options:
  parameters: {id: gbf_test_29, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_6000
  id: analog_sig_source_x
  parameters: {type: float, freq: '6000'}
- name: fm_mod
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: 2*math.pi*2500/samp_rate}
- name: fm_demod
  id: analog_quadrature_demod_cf
  parameters: {gain: samp_rate/(2*math.pi*2500)}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-5500'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: shifted.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: float, const: '0.8'}
connections:
- [fm_mod, '0', fm_demod, '0']
- [fm_demod, '0', hilbert, '0']
- [hilbert, '0', conj, '0']
- [conj, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', out, '0']
- [tone_6000, '0', gain, '0']
- [gain, '0', fm_mod, '0']
metadata: {file_format: 1}
