options:
  parameters: {id: gbf_test_50, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_2100
  id: analog_sig_source_x
  parameters: {type: float, freq: '2100', amp: '0.25'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-1000'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: shifted.dat}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -1250/samp_rate, taps: '[1.0]'}
- name: out_b
  id: blocks_file_sink
  parameters: {type: complex, file: second_received.dat}
- name: rate_limit
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
connections:
- [tone_2100, '0', hilbert, '0']
- [hilbert, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', out, '0']
- [hilbert, '0', channel, '0']
- [channel, '0', rate_limit, '0']
- [rate_limit, '0', out_b, '0']
metadata: {file_format: 1}
