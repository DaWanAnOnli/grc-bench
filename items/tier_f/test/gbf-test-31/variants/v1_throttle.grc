options:
  parameters: {id: gbf_test_31, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: square_450
  id: analog_sig_source_x
  parameters: {type: float, waveform: analog.GR_SQR_WAVE, freq: '450', amp: '2'}
- name: lpf
  id: low_pass_filter
  parameters: {type: fir_filter_fff, cutoff_freq: '900', width: '200'}
- name: to_short
  id: blocks_float_to_short
  parameters: {scale: '1000'}
- name: to_float
  id: blocks_short_to_float
  parameters: {scale: '1000'}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: quantized.dat}
- name: rate_limit
  id: blocks_throttle2
  parameters: {type: float, limit: auto}
connections:
- [square_450, '0', lpf, '0']
- [lpf, '0', to_short, '0']
- [to_short, '0', to_float, '0']
- [to_float, '0', rate_limit, '0']
- [rate_limit, '0', out, '0']
metadata: {file_format: 1}
