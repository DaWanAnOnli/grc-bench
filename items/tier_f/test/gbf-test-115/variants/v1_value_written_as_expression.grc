options:
  parameters: {id: gbf_test_115, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_5400
  id: analog_sig_source_x
  parameters: {type: complex, freq: (2700)*2, amp: '0.6'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 2250/samp_rate, taps: '[1.0]'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
connections:
- [tone_5400, '0', conj, '0']
- [conj, '0', channel, '0']
- [channel, '0', out, '0']
metadata: {file_format: 1}
