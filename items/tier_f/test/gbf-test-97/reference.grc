options:
  parameters: {id: gbf_test_97, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_2300
  id: analog_sig_source_x
  parameters: {type: float, freq: '2300', amp: '0.8', showports: 'True'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 3200})', period: '250'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: float, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat}
- name: to_short
  id: blocks_float_to_short
  parameters: {scale: '10'}
- name: to_float
  id: blocks_short_to_float
  parameters: {scale: '10'}
- name: out_b
  id: blocks_file_sink
  parameters: {type: float, file: second_quantized.dat}
connections:
- [hilbert, '0', conj, '0']
- [retune, strobe, tone_2300, cmd]
- [tone_2300, '0', throttle, '0']
- [throttle, '0', hilbert, '0']
- [conj, '0', out, '0']
- [tone_2300, '0', to_short, '0']
- [to_short, '0', to_float, '0']
- [to_float, '0', out_b, '0']
metadata: {file_format: 1}
