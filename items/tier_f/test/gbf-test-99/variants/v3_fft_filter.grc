options:
  parameters: {id: gbf_test_99, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: square_850
  id: analog_sig_source_x
  parameters: {type: float, waveform: analog.GR_SQR_WAVE, freq: '850', amp: '2'}
- name: lpf
  id: fft_filter_xxx
  parameters: {type: fff, taps: 'firdes.low_pass(1, samp_rate, 1700, 200)'}
- name: to_short
  id: blocks_float_to_short
  parameters: {scale: '100'}
- name: to_float
  id: blocks_short_to_float
  parameters: {scale: '100'}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: quantized.dat}
connections:
- [square_850, '0', lpf, '0']
- [lpf, '0', to_short, '0']
- [to_short, '0', to_float, '0']
- [to_float, '0', out, '0']
metadata: {file_format: 1}
