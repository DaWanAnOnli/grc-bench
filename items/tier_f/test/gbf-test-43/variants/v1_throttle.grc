options:
  parameters: {id: gbf_test_43, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_6300
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-6300', amp: '0.4', showports: 'True'}
- name: agc
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-2, reference: '2', gain: '1'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 500/samp_rate, taps: '[1.0]'}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': -4400})', period: '200'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, decim: '2'}
- name: out_b
  id: blocks_file_sink
  parameters: {type: complex, file: second_resampled.dat}
- name: rate_limit
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
connections:
- [agc, '0', conj, '0']
- [conj, '0', channel, '0']
- [retune, strobe, tone_6300, cmd]
- [tone_6300, '0', throttle, '0']
- [throttle, '0', agc, '0']
- [channel, '0', out, '0']
- [channel, '0', resampler, '0']
- [resampler, '0', rate_limit, '0']
- [rate_limit, '0', out_b, '0']
metadata: {file_format: 1}
