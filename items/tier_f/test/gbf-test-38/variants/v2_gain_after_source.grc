options:
  parameters: {id: gbf_test_38, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_2400
  id: analog_sig_source_x
  parameters: {type: complex, freq: '2400'}
- name: tone_5100
  id: analog_sig_source_x
  parameters: {type: complex, freq: '5100', amp: '0.4'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '3', decim: '2'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate*3/2, freq: '-1000'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: complex, const: '0.8'}
connections:
- [tone_5100, '0', sum_of_tones, '1']
- [sum_of_tones, '0', resampler, '0']
- [resampler, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', conj, '0']
- [conj, '0', out, '0']
- [tone_2400, '0', gain, '0']
- [gain, '0', sum_of_tones, '0']
metadata: {file_format: 1}
