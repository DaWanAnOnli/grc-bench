options:
  parameters: {id: gbf_test_62, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_6800
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-6800', showports: 'True'}
- name: agc
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-2, reference: '2.000000e+00', gain: '1'}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '3', decim: '2'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 2750/(samp_rate*3/2), taps: '[1.0]'}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': -4800})', period: '250'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
connections:
- [agc, '0', resampler, '0']
- [resampler, '0', channel, '0']
- [retune, strobe, tone_6800, cmd]
- [tone_6800, '0', throttle, '0']
- [throttle, '0', agc, '0']
- [channel, '0', out, '0']
metadata: {file_format: 1}
