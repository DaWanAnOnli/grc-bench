options:
  parameters: {id: gbf_test_24, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_7800
  id: analog_sig_source_x
  parameters: {type: float, freq: '7800', amp: '0.5'}
- name: tone_5800
  id: analog_sig_source_x
  parameters: {type: float, freq: '5800', amp: '0.6'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float}
- name: lpf
  id: fft_filter_xxx
  parameters: {type: fff, taps: 'firdes.low_pass(1, samp_rate, 6800, 200)'}
- name: to_short
  id: blocks_float_to_short
  parameters: {scale: '10'}
- name: to_float
  id: blocks_short_to_float
  parameters: {scale: '10'}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: quantized.dat}
connections:
- [tone_7800, '0', sum_of_tones, '0']
- [tone_5800, '0', sum_of_tones, '1']
- [sum_of_tones, '0', lpf, '0']
- [lpf, '0', to_short, '0']
- [to_short, '0', to_float, '0']
- [to_float, '0', out, '0']
metadata: {file_format: 1}
