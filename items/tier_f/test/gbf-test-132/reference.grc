options:
  parameters: {id: gbf_test_132, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_5500
  id: analog_sig_source_x
  parameters: {type: float, freq: '5500', amp: '0.4'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat}
- name: to_short
  id: blocks_float_to_short
  parameters: {scale: '100'}
- name: to_float
  id: blocks_short_to_float
  parameters: {scale: '100'}
- name: out_b
  id: blocks_file_sink
  parameters: {type: float, file: second_quantized.dat}
connections:
- [tone_5500, '0', hilbert, '0']
- [hilbert, '0', conj, '0']
- [conj, '0', out, '0']
- [tone_5500, '0', to_short, '0']
- [to_short, '0', to_float, '0']
- [to_float, '0', out_b, '0']
metadata: {file_format: 1}
