options:
  parameters: {id: gbf_test_53, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_12500
  id: analog_sig_source_x
  parameters: {type: float, freq: '12500', amp: '0.5'}
- name: tone_2700
  id: analog_sig_source_x
  parameters: {type: float, freq: '2.700000e+03', amp: '0.8'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-7500'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -1000/samp_rate, taps: '[1.0]'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
connections:
- [tone_12500, '0', sum_of_tones, '0']
- [tone_2700, '0', sum_of_tones, '1']
- [sum_of_tones, '0', hilbert, '0']
- [hilbert, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', channel, '0']
- [channel, '0', out, '0']
metadata: {file_format: 1}
