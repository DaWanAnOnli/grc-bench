options:
  parameters: {id: gbf_test_135, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_6100
  id: analog_sig_source_x
  parameters: {type: float, freq: '6100'}
- name: tone_7800
  id: analog_sig_source_x
  parameters: {type: float, freq: '7800', amp: '0.8'}
- name: noise
  id: analog_noise_source_x
  parameters: {type: float, amp: '0.2'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float, num_inputs: '3'}
- name: lpf
  id: low_pass_filter
  parameters: {type: fir_filter_fff, cutoff_freq: '6950', width: '200'}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: fff, interp: '2'}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: resampled.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: float, const: '0.25'}
connections:
- [tone_7800, '0', sum_of_tones, '1']
- [noise, '0', sum_of_tones, '2']
- [sum_of_tones, '0', lpf, '0']
- [lpf, '0', resampler, '0']
- [resampler, '0', out, '0']
- [tone_6100, '0', gain, '0']
- [gain, '0', sum_of_tones, '0']
metadata: {file_format: 1}
