options:
  parameters: {id: gbf_test_122, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_1200
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '1200', amp: '0.5',
    offset: '0'}
- name: tone_4100
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '4100', amp: '0.6',
    offset: '0'}
- name: tone_7300
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '7300', amp: '0.4',
    offset: '0'}
- name: noise
  id: analog_noise_source_x
  parameters: {type: complex, noise_type: analog.GR_GAUSSIAN, amp: '0.2', seed: '0'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex, num_inputs: '4'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '5250', amp: '1',
    offset: '0'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex, num_inputs: '2'}
- name: channel
  id: channels_channel_model_x
  parameters: {noise_voltage: '0', freq_offset: -2000/samp_rate, epsilon: '1.0', taps: '[1.0]', seed: '0',
    block_tags: 'False'}
- name: channel_2
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 3000/samp_rate, epsilon: '1.0', taps: '[1.0]', seed: '0',
    block_tags: 'False'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat, append: 'False', unbuffered: 'False', vlen: '1'}
connections:
- [tone_1200, '0', sum_of_tones, '0']
- [tone_4100, '0', sum_of_tones, '1']
- [tone_7300, '0', sum_of_tones, '2']
- [noise, '0', sum_of_tones, '3']
- [sum_of_tones, '0', conj, '0']
- [conj, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', channel, '0']
- [channel, '0', channel_2, '0']
- [channel_2, '0', out, '0']
metadata: {file_format: 1}
