options:
  parameters: {id: gbf_test_122, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_1200
  id: analog_sig_source_x
  parameters: {type: complex, freq: '1200'}
- name: tone_4100
  id: analog_sig_source_x
  parameters: {type: complex, freq: '4100', amp: '0.6'}
- name: tone_7300
  id: analog_sig_source_x
  parameters: {type: complex, freq: '7300', amp: '0.4'}
- name: noise
  id: analog_noise_source_x
  parameters: {type: complex, amp: '0.2'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex, num_inputs: '4'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '5250'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -2000/samp_rate, taps: '[1.0]'}
- name: channel_2
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 3000/samp_rate, taps: '[1.0]'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: complex, const: '0.5'}
connections:
- [tone_4100, '0', sum_of_tones, '1']
- [tone_7300, '0', sum_of_tones, '2']
- [noise, '0', sum_of_tones, '3']
- [sum_of_tones, '0', conj, '0']
- [conj, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', channel, '0']
- [channel, '0', channel_2, '0']
- [channel_2, '0', out, '0']
- [tone_1200, '0', gain, '0']
- [gain, '0', sum_of_tones, '0']
metadata: {file_format: 1}
