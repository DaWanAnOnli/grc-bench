options:
  parameters: {id: gbf_test_140, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_2400
  id: analog_sig_source_x
  parameters: {type: float, freq: '2400', showports: 'True'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 2000/samp_rate, taps: '[1.0]'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '1500'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 3800})', period: '200'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: float, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: shifted.dat}
connections:
- [hilbert, '0', channel, '0']
- [channel, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [retune, strobe, tone_2400, cmd]
- [tone_2400, '0', throttle, '0']
- [throttle, '0', hilbert, '0']
- [mixer, '0', out, '0']
metadata: {file_format: 1}
