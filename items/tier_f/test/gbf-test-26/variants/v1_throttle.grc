options:
  parameters: {id: gbf_test_26, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_10400
  id: analog_sig_source_x
  parameters: {type: complex, freq: '10400', amp: '0.6'}
- name: tone_1300
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-1300', amp: '0.25'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 1750/samp_rate, taps: '[1.0]'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
- name: lpf
  id: low_pass_filter
  parameters: {type: fir_filter_ccf, cutoff_freq: '5850', width: '200'}
- name: out_b
  id: blocks_file_sink
  parameters: {type: complex, file: second_filtered.dat}
- name: rate_limit
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
connections:
- [tone_10400, '0', sum_of_tones, '0']
- [tone_1300, '0', sum_of_tones, '1']
- [sum_of_tones, '0', channel, '0']
- [channel, '0', out, '0']
- [sum_of_tones, '0', lpf, '0']
- [lpf, '0', rate_limit, '0']
- [rate_limit, '0', out_b, '0']
metadata: {file_format: 1}
