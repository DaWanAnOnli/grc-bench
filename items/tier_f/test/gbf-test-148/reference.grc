options:
  parameters: {id: gbf_test_148, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_7300
  id: analog_sig_source_x
  parameters: {type: float, freq: '7300', amp: '0.6'}
- name: fm_mod
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: 2*math.pi*1000/samp_rate}
- name: fm_demod
  id: analog_quadrature_demod_cf
  parameters: {gain: samp_rate/(2*math.pi*1000)}
- name: fm_mod_2
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: 2*math.pi*1500/samp_rate}
- name: fm_demod_2
  id: analog_quadrature_demod_cf
  parameters: {gain: samp_rate/(2*math.pi*3000)}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: power
  id: blocks_complex_to_mag_squared
  parameters: {}
- name: average
  id: blocks_moving_average_xx
  parameters: {type: float, length: '2000', scale: 1/2000}
- name: to_db
  id: blocks_nlog10_ff
  parameters: {n: '10'}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: power_db.dat}
connections:
- [tone_7300, '0', fm_mod, '0']
- [fm_mod, '0', fm_demod, '0']
- [fm_demod, '0', fm_mod_2, '0']
- [fm_mod_2, '0', fm_demod_2, '0']
- [fm_demod_2, '0', hilbert, '0']
- [hilbert, '0', power, '0']
- [power, '0', average, '0']
- [average, '0', to_db, '0']
- [to_db, '0', out, '0']
metadata: {file_format: 1}
