options:
  parameters: {id: gbf_test_102, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_9700
  id: analog_sig_source_x
  parameters: {type: float, freq: '9700'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat}
- name: to_short
  id: blocks_float_to_short
  parameters: {scale: '1000'}
- name: to_float
  id: blocks_short_to_float
  parameters: {scale: '1000'}
- name: out_b
  id: blocks_file_sink
  parameters: {type: float, file: second_quantized.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: float, const: '0.5'}
connections:
- [hilbert, '0', conj, '0']
- [conj, '0', out, '0']
- [to_short, '0', to_float, '0']
- [to_float, '0', out_b, '0']
- [tone_9700, '0', gain, '0']
- [gain, '0', hilbert, '0']
- [gain, '0', to_short, '0']
metadata: {file_format: 1}
