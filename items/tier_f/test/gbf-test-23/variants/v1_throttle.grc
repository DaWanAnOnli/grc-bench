options:
  parameters: {id: gbf_test_23, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_1500
  id: analog_sig_source_x
  parameters: {type: complex, freq: '1500', amp: '0.8'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '2500'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '2'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: resampled.dat}
- name: lo_2
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate*2/1, freq: '1500'}
- name: mixer_2
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: out_b
  id: blocks_file_sink
  parameters: {type: complex, file: second_shifted.dat}
- name: rate_limit
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
connections:
- [tone_1500, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', conj, '0']
- [conj, '0', resampler, '0']
- [resampler, '0', out, '0']
- [resampler, '0', mixer_2, '0']
- [lo_2, '0', mixer_2, '1']
- [mixer_2, '0', rate_limit, '0']
- [rate_limit, '0', out_b, '0']
metadata: {file_format: 1}
