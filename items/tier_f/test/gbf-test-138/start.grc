options:
  parameters: {id: gbf_test_138, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_4100
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-4100', amp: '0.5', showports: 'True'}
- name: noise
  id: analog_noise_source_x
  parameters: {type: complex, amp: '0.1'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, decim: '3'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 1750/(samp_rate*1/3), taps: '[1.0]'}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': -3800})', period: '200'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
connections:
- [noise, '0', sum_of_tones, '1']
- [sum_of_tones, '0', resampler, '0']
- [resampler, '0', conj, '0']
- [conj, '0', channel, '0']
- [retune, strobe, tone_4100, cmd]
- [tone_4100, '0', throttle, '0']
- [throttle, '0', sum_of_tones, '0']
- [channel, '0', out, '0']
metadata: {file_format: 1}
