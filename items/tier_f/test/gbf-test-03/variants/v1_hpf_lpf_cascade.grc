options:
  parameters: {id: noise_band_cascade, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: 40e3}
- name: src
  id: analog_noise_source_x
  parameters: {type: float, amp: '2.0', noise_type: analog.GR_GAUSSIAN}
- name: hpf
  id: high_pass_filter
  parameters: {type: fir_filter_fff, cutoff_freq: '6000', width: '500'}
- name: lpf
  id: low_pass_filter
  parameters: {type: fir_filter_fff, cutoff_freq: '9000', width: '500'}
- name: out_file
  id: blocks_file_sink
  parameters: {type: float, file: bandnoise.dat}
connections:
- [src, '0', hpf, '0']
- [hpf, '0', lpf, '0']
- [lpf, '0', out_file, '0']
metadata: {file_format: 1}
