options:
  parameters: {id: noise_bh_taps, generate_options: no_gui, output_language: python}
blocks:
- name: import_0
  id: import
  parameters: {imports: from gnuradio.fft import window}
- name: samp_rate
  id: variable
  parameters: {value: '40000'}
- name: noise_0
  id: analog_noise_source_x
  parameters: {type: float, amp: '2.0', seed: '11', noise_type: analog.GR_GAUSSIAN}
- name: fft_bp
  id: fft_filter_xxx
  parameters: {type: fff, taps: 'firdes.band_pass(1, samp_rate, 6000, 9000, 100, window.WIN_BLACKMAN_HARRIS)'}
- name: throttle_0
  id: blocks_throttle2
  parameters: {type: float}
- name: file_sink_0
  id: blocks_file_sink
  parameters: {type: float, file: bandnoise.dat}
connections:
- [noise_0, '0', fft_bp, '0']
- [fft_bp, '0', throttle_0, '0']
- [throttle_0, '0', file_sink_0, '0']
metadata: {file_format: 1}
