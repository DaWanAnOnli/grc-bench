options:
  parameters: {id: band_limited_noise, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '40000'}
- name: noise
  id: analog_noise_source_x
  parameters: {type: float, amp: '2.0', seed: '2718', noise_type: analog.GR_GAUSSIAN}
- name: thr
  id: blocks_throttle2
  parameters: {type: float}
- name: bpf
  id: band_pass_filter
  parameters: {type: fir_filter_fff, low_cutoff_freq: '6000', high_cutoff_freq: '9000', width: '500'}
- name: snk
  id: blocks_file_sink
  parameters: {type: float, file: bandnoise.dat}
connections:
- [noise, '0', thr, '0']
- [thr, '0', bpf, '0']
- [bpf, '0', snk, '0']
metadata: {file_format: 1}
