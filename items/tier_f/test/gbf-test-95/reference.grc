options:
  parameters: {id: gbf_test_95, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_5400
  id: analog_sig_source_x
  parameters: {type: complex, freq: '5400', amp: '0.5'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -2250/samp_rate, taps: '[1.0]'}
- name: channel_2
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 2250/samp_rate, taps: '[1.0]'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
connections:
- [tone_5400, '0', channel, '0']
- [channel, '0', channel_2, '0']
- [channel_2, '0', out, '0']
metadata: {file_format: 1}
