options:
  parameters: {id: gbf_test_22, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_7400
  id: analog_sig_source_x
  parameters: {type: float, freq: '7400', amp: '0.4'}
- name: to_short
  id: blocks_float_to_short
  parameters: {scale: '10'}
- name: to_float
  id: blocks_short_to_float
  parameters: {scale: '10'}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: quantized.dat}
connections:
- [tone_7400, '0', to_short, '0']
- [to_short, '0', to_float, '0']
- [to_float, '0', out, '0']
metadata: {file_format: 1}
