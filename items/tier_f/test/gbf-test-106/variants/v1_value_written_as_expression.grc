options:
  parameters: {id: gbf_test_106, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_2200
  id: analog_sig_source_x
  parameters: {type: complex, freq: '2200', amp: '0.4'}
- name: tone_11200
  id: analog_sig_source_x
  parameters: {type: complex, freq: (-5600)*2, amp: '0.4'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat}
connections:
- [tone_2200, '0', sum_of_tones, '0']
- [tone_11200, '0', sum_of_tones, '1']
- [sum_of_tones, '0', conj, '0']
- [conj, '0', out, '0']
metadata: {file_format: 1}
