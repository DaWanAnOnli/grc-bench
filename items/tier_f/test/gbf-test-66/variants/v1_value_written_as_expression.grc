options:
  parameters: {id: gbf_test_66, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_1500
  id: analog_sig_source_x
  parameters: {type: float, freq: '1500', amp: '0.6', showports: 'True'}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: fff, interp: '3', decim: '2'}
- name: rectifier
  id: blocks_abs_xx
  parameters: {type: float}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 2100.0})', period: '200'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: float, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: rectified.dat}
connections:
- [resampler, '0', rectifier, '0']
- [retune, strobe, tone_1500, cmd]
- [tone_1500, '0', throttle, '0']
- [throttle, '0', resampler, '0']
- [rectifier, '0', out, '0']
metadata: {file_format: 1}
