options:
  parameters: {id: gbf_test_165, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_1
  id: analog_sig_source_x
  parameters: {type: float, freq: '5600', amp: '0.25'}
- name: fm_mod
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: 2*math.pi*2000/samp_rate}
- name: fm_demod
  id: analog_quadrature_demod_cf
  parameters: {gain: samp_rate/(2*math.pi*1000)}
- name: to_short
  id: blocks_float_to_short
  parameters: {scale: '100'}
- name: to_float
  id: blocks_short_to_float
  parameters: {scale: '100'}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: quantized.dat}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: out_b
  id: blocks_file_sink
  parameters: {type: complex, file: second_analytic.dat}
connections:
- [tone_1, '0', fm_mod, '0']
- [fm_mod, '0', fm_demod, '0']
- [fm_demod, '0', to_short, '0']
- [to_short, '0', to_float, '0']
- [to_float, '0', out, '0']
- [tone_1, '0', hilbert, '0']
- [hilbert, '0', out_b, '0']
metadata: {file_format: 1}
