options:
  parameters: {id: gbf_test_113, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_10900
  id: analog_sig_source_x
  parameters: {type: float, freq: '10900'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -1000/samp_rate, taps: '[1.0]'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
- name: to_short
  id: blocks_float_to_short
  parameters: {scale: '10'}
- name: to_float
  id: blocks_short_to_float
  parameters: {scale: '10'}
- name: out_b
  id: blocks_file_sink
  parameters: {type: float, file: second_quantized.dat}
connections:
- [tone_10900, '0', hilbert, '0']
- [hilbert, '0', channel, '0']
- [channel, '0', out, '0']
- [tone_10900, '0', to_short, '0']
- [to_short, '0', to_float, '0']
- [to_float, '0', out_b, '0']
metadata: {file_format: 1}
