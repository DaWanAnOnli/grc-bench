options:
  parameters: {id: gbf_test_41, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_1800
  id: analog_sig_source_x
  parameters: {type: float, freq: '1800'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 2500/samp_rate, taps: '[1.0]'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
- name: channel_2
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -2750/samp_rate, taps: '[1.0]'}
- name: out_b
  id: blocks_file_sink
  parameters: {type: complex, file: second_received.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: float, const: '0.6'}
connections:
- [hilbert, '0', channel, '0']
- [channel, '0', out, '0']
- [hilbert, '0', channel_2, '0']
- [channel_2, '0', out_b, '0']
- [tone_1800, '0', gain, '0']
- [gain, '0', hilbert, '0']
metadata: {file_format: 1}
