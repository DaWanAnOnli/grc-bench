options:
  parameters: {id: gbf_test_61, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_8900
  id: analog_sig_source_x
  parameters: {type: float, freq: '8900', showports: 'True'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: agc
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-2, reference: '1', gain: '1'}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 6200})', period: '100'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: float, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: levelled.dat}
- name: fm_mod
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: 2*math.pi*2000/samp_rate}
- name: fm_demod
  id: analog_quadrature_demod_cf
  parameters: {gain: samp_rate/(2*math.pi*2000)}
- name: out_b
  id: blocks_file_sink
  parameters: {type: float, file: second_recovered.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: float, const: '0.25'}
connections:
- [hilbert, '0', agc, '0']
- [retune, strobe, tone_8900, cmd]
- [throttle, '0', hilbert, '0']
- [agc, '0', out, '0']
- [fm_mod, '0', fm_demod, '0']
- [fm_demod, '0', out_b, '0']
- [tone_8900, '0', gain, '0']
- [gain, '0', throttle, '0']
- [gain, '0', fm_mod, '0']
metadata: {file_format: 1}
