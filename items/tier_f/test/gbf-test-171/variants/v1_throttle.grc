options:
  parameters: {id: gbf_test_171, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_1
  id: analog_sig_source_x
  parameters: {type: complex, freq: '4100', amp: '0.25'}
- name: noise
  id: analog_noise_source_x
  parameters: {type: complex, amp: '0.05'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '5000'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '2'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: resampled.dat}
- name: rate_limit
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
connections:
- [tone_1, '0', sum_of_tones, '0']
- [noise, '0', sum_of_tones, '1']
- [sum_of_tones, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', conj, '0']
- [conj, '0', resampler, '0']
- [resampler, '0', rate_limit, '0']
- [rate_limit, '0', out, '0']
metadata: {file_format: 1}
