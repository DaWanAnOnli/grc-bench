options:
  parameters: {id: gbf_test_56, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_4400
  id: analog_sig_source_x
  parameters: {type: float, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '4400', amp: '0.4',
    offset: '0'}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: fff, interp: '1', decim: '2', taps: '[]', fbw: '0'}
- name: hilbert
  id: hilbert_fc
  parameters: {num_taps: '65', win: window.WIN_HAMMING, beta: '6.76'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate*1/2, waveform: analog.GR_COS_WAVE, freq: '2000', amp: '1',
    offset: '0'}
- name: mixer
  id: blocks_multiply_x
  parameters: {type: complex, num_inputs: '2'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: shifted.dat, append: 'False', unbuffered: 'False', vlen: '1'}
connections:
- [tone_4400, '0', resampler, '0']
- [resampler, '0', hilbert, '0']
- [hilbert, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', out, '0']
metadata: {file_format: 1}
