options:
  parameters: {id: gbf_test_167, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_1
  id: analog_sig_source_x
  parameters: {type: complex, freq: '9500', amp: '0.8'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-8000'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, decim: '2'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 1500/(samp_rate*1/2), taps: '[1.0]'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
connections:
- [tone_1, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', resampler, '0']
- [resampler, '0', conj, '0']
- [conj, '0', channel, '0']
- [channel, '0', out, '0']
metadata: {file_format: 1}
