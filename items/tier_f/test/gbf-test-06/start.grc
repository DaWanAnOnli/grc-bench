options:
  parameters:
    id: sig_source_msg_ports
    title: 'Demonstration: Signal Source Message Ports'
    author: Marcus Müller
    copyright: 2020 Free Software Foundation
    generate_options: no_gui
    output_language: python
blocks:
- name: analog_sig_source_x_0
  id: analog_sig_source_x
  parameters:
    showports: 'True'
    type: complex
    freq: '1500'
    amp: '0.8'
- name: blocks_message_strobe_0
  id: blocks_message_strobe
  parameters:
    comment: sets the amplitude and frequency every half second
    msg: 'pmt.to_pmt({"freq": 3000, "ampl": 0.5})'
    period: '500'
- name: blocks_message_strobe_random_0
  id: blocks_message_strobe_random
  parameters:
    comment: resets the phase at random points in time
    dist: blocks.STROBE_GAUSSIAN
    mean: '100'
    msg: pmt.to_pmt({"phase":0.0})
    std: '20'
- name: blocks_throttle2_0
  id: blocks_throttle2
  parameters:
    limit: auto
    type: complex
- name: qtgui_time_sink_x_0_0
  id: blocks_file_sink
  parameters:
    file: qtgui_time_sink_x_0_0.dat
    type: complex
- name: samp_rate
  id: parameter
  parameters:
    hide: none
    label: Sampling Rate [Hz]
    short_id: r
    type: eng_float
    value: 48e3
connections:
- [analog_sig_source_x_0, '0', blocks_throttle2_0, '0']
- [blocks_message_strobe_0, strobe, blocks_message_strobe_random_0, set_msg]
- [blocks_message_strobe_random_0, strobe, analog_sig_source_x_0, cmd]
- [blocks_throttle2_0, '0', qtgui_time_sink_x_0_0, '0']
metadata:
  file_format: 1
