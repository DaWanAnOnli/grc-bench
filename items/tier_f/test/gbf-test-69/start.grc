options:
  parameters: {id: gbf_test_69, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_2600
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '2600', amp: '0.25',
    offset: '0'}
- name: tone_8000
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '8000', amp: '1',
    offset: '0'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex, num_inputs: '2'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '4500', amp: '1',
    offset: '0'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex, num_inputs: '2'}
- name: lpf
  id: low_pass_filtre
  parameters: {type: fir_filter_ccf, decim: '1', gain: '1', samp_rate: samp_rate, cutoff_freq: '9800',
    width: '400', win: window.WIN_HAMMING, beta: '6.76'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat, append: 'False', unbuffered: 'False', vlen: '1'}
connections:
- [tone_2600, '0', sum_of_tones, '0']
- [tone_8000, '0', sum_of_tones, '1']
- [sum_of_tones, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', lpf, '0']
- [lpf, '0', conj, '0']
- [conj, '0', out, '0']
metadata: {file_format: 1}
