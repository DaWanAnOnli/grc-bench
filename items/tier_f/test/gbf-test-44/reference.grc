options:
  parameters: {id: gbf_test_44, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_6500
  id: analog_sig_source_x
  parameters: {type: complex, freq: '6500', amp: '0.6'}
- name: noise
  id: analog_noise_source_x
  parameters: {type: complex, amp: '0.2'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat}
- name: conj_2
  id: blocks_conjugate_cc
  parameters: {}
- name: out_b
  id: blocks_file_sink
  parameters: {type: complex, file: second_mirrored.dat}
connections:
- [tone_6500, '0', sum_of_tones, '0']
- [noise, '0', sum_of_tones, '1']
- [sum_of_tones, '0', conj, '0']
- [conj, '0', out, '0']
- [sum_of_tones, '0', conj_2, '0']
- [conj_2, '0', out_b, '0']
metadata: {file_format: 1}
