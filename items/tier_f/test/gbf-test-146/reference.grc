options:
  parameters: {id: gbf_test_146, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_1100
  id: analog_sig_source_x
  parameters: {type: complex, freq: '1100', amp: '0.5'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, decim: '2'}
- name: conj_2
  id: blocks_conjugate_cc
  parameters: {}
- name: conj_3
  id: blocks_conjugate_cc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat}
connections:
- [tone_1100, '0', conj, '0']
- [conj, '0', resampler, '0']
- [resampler, '0', conj_2, '0']
- [conj_2, '0', conj_3, '0']
- [conj_3, '0', out, '0']
metadata: {file_format: 1}
