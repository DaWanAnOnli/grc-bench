options:
  parameters: {id: gbf_test_119, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_6800
  id: analog_sig_source_x
  parameters: {type: float, freq: '6800', showports: 'True'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 750/samp_rate, taps: '[1.0]'}
- name: channel_2
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -2250/samp_rate, taps: '[1.0]'}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 4800})', period: '250'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: float, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: float, const: '0.25'}
connections:
- [hilbert, '0', channel, '0']
- [channel, '0', channel_2, '0']
- [retune, strobe, tone_6800, cmd]
- [throttle, '0', hilbert, '0']
- [channel_2, '0', out, '0']
- [tone_6800, '0', gain, '0']
- [gain, '0', throttle, '0']
metadata: {file_format: 1}
