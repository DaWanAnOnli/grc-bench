options:
  parameters: {id: gbf_test_119, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_6800
  id: analog_sig_source_x
  parameters: {type: float, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '6800', amp: '0.25',
    offset: '0', showports: 'True'}
- name: hilbert
  id: hilbert_fc
  parameters: {num_taps: '65', win: window.WIN_HAMMING, beta: '6.76'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 750/samp_rate, epsilon: '1.0', taps: '[1.0]', seed: '0',
    block_tags: 'False'}
- name: channel_2
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -2250/samp_rate, epsilon: '1.0', taps: '[1.0]', seed: '0',
    block_tags: 'False'}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 4800})', period: '250'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: float, samples_per_second: samp_rate, ignoretag: 'True', maximum: '0.1', limit: auto,
    vlen: '1'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat, append: 'False', unbuffered: 'False', vlen: '1'}
connections:
- [channel, '0', channel_2, '0']
- [retune, strobe, tone_6800, cmd]
- [tone_6800, '0', throttle, '0']
- [throttle, '0', hilbert, '0']
- [channel_2, '0', out, '0']
metadata: {file_format: 1}
