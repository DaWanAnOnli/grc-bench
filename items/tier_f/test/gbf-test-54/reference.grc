options:
  parameters: {id: gbf_test_54, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_8400
  id: analog_sig_source_x
  parameters: {type: complex, freq: '8400', showports: 'True'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -2500/samp_rate, taps: '[1.0]'}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 11800})', period: '200'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
connections:
- [conj, '0', channel, '0']
- [retune, strobe, tone_8400, cmd]
- [tone_8400, '0', throttle, '0']
- [throttle, '0', conj, '0']
- [channel, '0', out, '0']
metadata: {file_format: 1}
