options:
  parameters: {id: gbf_test_54, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_8400
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '8400', amp: '1',
    offset: '0', showports: 'True'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -2500/samp_rate, epsilon: '1.0', taps: '[1.0]', seed: '0',
    block_tags: 'False'}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 11800})', period: '200'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: complex, samples_per_second: samp_rate, ignoretag: 'True', maximum: '0.1', limit: auto,
    vlen: '1'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat, append: 'False', unbuffered: 'False', vlen: '1'}
connections:
- [retune, strobe, tone_8400, cmd]
- [tone_8400, '0', throttle, '0']
- [throttle, '0', conj, '0']
- [channel, '0', out, '0']
metadata: {file_format: 1}
