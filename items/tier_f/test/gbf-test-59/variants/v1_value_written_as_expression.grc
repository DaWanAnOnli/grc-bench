options:
  parameters: {id: gbf_test_59, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_5200
  id: analog_sig_source_x
  parameters: {type: float, freq: '5200', amp: '0.5'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '3', decim: '2'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 1250/(samp_rate*3/2), taps: '[1.0]'}
- name: agc
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-2, reference: (1)*2, gain: '1'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: levelled.dat}
connections:
- [tone_5200, '0', hilbert, '0']
- [hilbert, '0', resampler, '0']
- [resampler, '0', channel, '0']
- [channel, '0', agc, '0']
- [agc, '0', out, '0']
metadata: {file_format: 1}
