options:
  parameters: {id: bpsk_demapper_v5, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: import_gr
  id: import
  parameters: {imports: from gnuradio import gr}
- name: soft
  id: blocks_vector_source_x
  parameters: {type: float, vector: '[-0.92, 1.07, -1.21, -0.05, 0.88, -1.13, 0.37, 1.02, 0.96, 0.12,
      -0.84, 1.18, -0.21, -0.97, -1.09, 0.79, -1.04, -0.44, 0.03, -0.91, -1.26, 0.83, 1.15, -0.68, 1.11,
      -0.73, -1.02, 0.94, 0.27, 1.31, -0.89, -0.16]'}
- name: slicer
  id: digital_binary_slicer_fb
  parameters: {}
- name: swap
  id: digital_map_bb
  parameters: {map: '[1, 0]'}
- name: pack
  id: blocks_unpacked_to_packed_xx
  parameters: {type: byte, bits_per_chunk: '1', endianness: gr.GR_MSB_FIRST}
- name: bits_sink
  id: blocks_file_sink
  parameters: {type: byte, file: bits.dat}
connections:
- [soft, '0', slicer, '0']
- [slicer, '0', swap, '0']
- [swap, '0', pack, '0']
- [pack, '0', bits_sink, '0']
metadata: {file_format: 1}
