options:
  parameters: {id: gbf_test_32, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: saw_1200
  id: analog_sig_source_x
  parameters: {type: float, waveform: analog.GR_SAW_WAVE, freq: (600)*2}
- name: lpf
  id: low_pass_filter
  parameters: {type: fir_filter_fff, cutoff_freq: '1800', width: '200'}
- name: to_short
  id: blocks_float_to_short
  parameters: {scale: '10'}
- name: to_float
  id: blocks_short_to_float
  parameters: {scale: '10'}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: quantized.dat}
connections:
- [saw_1200, '0', lpf, '0']
- [lpf, '0', to_short, '0']
- [to_short, '0', to_float, '0']
- [to_float, '0', out, '0']
metadata: {file_format: 1}
