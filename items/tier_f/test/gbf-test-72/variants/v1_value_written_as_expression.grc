options:
  parameters: {id: gbf_test_72, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_500
  id: analog_sig_source_x
  parameters: {type: float, freq: '500', amp: '0.25'}
- name: tone_3400
  id: analog_sig_source_x
  parameters: {type: float, freq: '3400'}
- name: tone_1700
  id: analog_sig_source_x
  parameters: {type: float, freq: '1700', amp: '0.25'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float, num_inputs: '3'}
- name: hpf
  id: high_pass_filter
  parameters: {type: fir_filter_fff, cutoff_freq: '1100', width: '400'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '5250'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: (2750/samp_rate), taps: '[1.0]'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
connections:
- [tone_500, '0', sum_of_tones, '0']
- [tone_3400, '0', sum_of_tones, '1']
- [tone_1700, '0', sum_of_tones, '2']
- [sum_of_tones, '0', hpf, '0']
- [hpf, '0', hilbert, '0']
- [hilbert, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', channel, '0']
- [channel, '0', out, '0']
metadata: {file_format: 1}
