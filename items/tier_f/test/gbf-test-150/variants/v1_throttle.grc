options:
  parameters: {id: gbf_test_150, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_3800
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-3800', amp: '0.6'}
- name: tone_11700
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-11700', amp: '0.5'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: lpf
  id: low_pass_filter
  parameters: {type: fir_filter_ccf, cutoff_freq: '7750', width: '200'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '2250'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: shifted.dat}
- name: power
  id: blocks_complex_to_mag_squared
  parameters: {}
- name: average
  id: blocks_moving_average_xx
  parameters: {type: float, length: '2000', scale: 1/2000}
- name: to_db
  id: blocks_nlog10_ff
  parameters: {n: '10'}
- name: out_b
  id: blocks_file_sink
  parameters: {type: float, file: second_power_db.dat}
- name: rate_limit
  id: blocks_throttle2
  parameters: {type: float, limit: auto}
connections:
- [tone_3800, '0', sum_of_tones, '0']
- [tone_11700, '0', sum_of_tones, '1']
- [sum_of_tones, '0', conj, '0']
- [conj, '0', lpf, '0']
- [lpf, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', out, '0']
- [lpf, '0', power, '0']
- [power, '0', average, '0']
- [average, '0', to_db, '0']
- [to_db, '0', rate_limit, '0']
- [rate_limit, '0', out_b, '0']
metadata: {file_format: 1}
