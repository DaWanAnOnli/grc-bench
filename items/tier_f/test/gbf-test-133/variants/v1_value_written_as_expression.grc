options:
  parameters: {id: gbf_test_133, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_5900
  id: analog_sig_source_x
  parameters: {type: complex, freq: '5900', amp: '0.5', showports: 'True'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-3500'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -1250/samp_rate, taps: '[1.0]'}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '2'}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 8300.0})', period: '200'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: resampled.dat}
connections:
- [lo, '0', mixer, '1']
- [mixer, '0', channel, '0']
- [channel, '0', resampler, '0']
- [retune, strobe, tone_5900, cmd]
- [tone_5900, '0', throttle, '0']
- [throttle, '0', mixer, '0']
- [resampler, '0', out, '0']
metadata: {file_format: 1}
