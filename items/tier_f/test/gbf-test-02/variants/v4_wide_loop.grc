options:
  parameters: {id: pll_carrier_recovery, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: carrier
  id: analog_sig_source_x
  parameters: {type: complex, freq: '2400', amp: '1.0'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0.7'}
- name: pll
  id: analog_pll_refout_cc
  parameters: {w: '0.08', max_freq: 6.283185307179586*8000/samp_rate, min_freq: -6.283185307179586*8000/samp_rate}
- name: received_sink
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
- name: carrier_sink
  id: blocks_file_sink
  parameters: {type: complex, file: carrier.dat}
connections:
- [carrier, '0', channel, '0']
- [channel, '0', received_sink, '0']
- [channel, '0', pll, '0']
- [pll, '0', carrier_sink, '0']
metadata: {file_format: 1}
