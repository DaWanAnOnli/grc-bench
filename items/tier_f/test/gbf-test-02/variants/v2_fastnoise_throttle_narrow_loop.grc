options:
  parameters: {id: pll_fastnoise, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone
  id: analog_sig_source_x
  parameters: {type: complex, freq: '2400', amp: '1.0'}
- name: noise
  id: analog_fastnoise_source_x
  parameters: {type: complex, amp: '0.7', seed: '5'}
- name: adder
  id: blocks_add_xx
  parameters: {type: complex}
- name: thr
  id: blocks_throttle2
  parameters: {type: complex}
- name: pll
  id: analog_pll_refout_cc
  parameters: {w: 3.141592653589793/200, max_freq: '3.141592653589793', min_freq: '-3.141592653589793'}
- name: received
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
- name: recovered
  id: blocks_file_sink
  parameters: {type: complex, file: carrier.dat}
connections:
- [noise, '0', adder, '0']
- [tone, '0', adder, '1']
- [adder, '0', thr, '0']
- [thr, '0', received, '0']
- [thr, '0', pll, '0']
- [pll, '0', recovered, '0']
metadata: {file_format: 1}
