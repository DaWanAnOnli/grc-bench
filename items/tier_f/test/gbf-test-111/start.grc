options:
  parameters: {id: gbf_test_111, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_5100
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '5100', amp: '0.8',
    offset: '0'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '2250', amp: '1',
    offset: '0'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex, num_inputs: '2'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -1000/samp_rate, epsilon: '1.0', taps: '[1.0]', seed: '0',
    block_tags: 'False'}
- name: agc
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-2, reference: '1', gain: '1', max_gain: '65536'}
- name: conj
  id: blocks_conjugate_cc_x
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat, append: 'False', unbuffered: 'False', vlen: '1'}
connections:
- [tone_5100, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', channel, '0']
- [channel, '0', agc, '0']
- [agc, '0', conj, '0']
- [conj, '0', out, '0']
metadata: {file_format: 1}
