options:
  parameters: {id: gbf_test_91, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_3700
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-3700'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: conj_2
  id: blocks_conjugate_cc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: complex, const: '0.8'}
connections:
- [conj, '0', conj_2, '0']
- [conj_2, '0', out, '0']
- [tone_3700, '0', gain, '0']
- [gain, '0', conj, '0']
metadata: {file_format: 1}
