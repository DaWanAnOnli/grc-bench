options:
  parameters: {id: gbf_test_144, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_1800
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-1800', showports: 'True'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-1250'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '3', decim: '2'}
- name: phase
  id: blocks_complex_to_arg
  parameters: {}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': -2900})', period: '250'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: phase.dat}
connections:
- [lo, '0', mixer, '1']
- [mixer, '0', resampler, '0']
- [resampler, '0', phase, '0']
- [retune, strobe, tone_1800, cmd]
- [tone_1800, '0', throttle, '0']
- [throttle, '0', mixer, '0']
- [phase, '0', out, '0']
metadata: {file_format: 1}
