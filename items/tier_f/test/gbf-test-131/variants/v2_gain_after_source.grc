options:
  parameters: {id: gbf_test_131, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_9400
  id: analog_sig_source_x
  parameters: {type: float, freq: '9400'}
- name: tone_3100
  id: analog_sig_source_x
  parameters: {type: float, freq: '3100', amp: '0.4'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float}
- name: hpf
  id: high_pass_filter
  parameters: {type: fir_filter_fff, cutoff_freq: '6250', width: '200'}
- name: fm_mod
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: 2*math.pi*2000/samp_rate}
- name: fm_demod
  id: analog_quadrature_demod_cf
  parameters: {gain: samp_rate/(2*math.pi*2000)}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: analytic.dat}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: fff, interp: '3', decim: '2'}
- name: out_b
  id: blocks_file_sink
  parameters: {type: float, file: second_resampled.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: float, const: '0.6'}
connections:
- [tone_3100, '0', sum_of_tones, '1']
- [sum_of_tones, '0', hpf, '0']
- [hpf, '0', fm_mod, '0']
- [fm_mod, '0', fm_demod, '0']
- [fm_demod, '0', hilbert, '0']
- [hilbert, '0', out, '0']
- [fm_demod, '0', resampler, '0']
- [resampler, '0', out_b, '0']
- [tone_9400, '0', gain, '0']
- [gain, '0', sum_of_tones, '0']
metadata: {file_format: 1}
