options:
  parameters: {id: gbf_test_71, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_7000
  id: analog_sig_source_x
  parameters: {type: float, freq: '7000'}
- name: tone_2600
  id: analog_sig_source_x
  parameters: {type: float, freq: '2600', amp: '0.8'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: analytic.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: float, const: '0.6'}
connections:
- [tone_2600, '0', sum_of_tones, '1']
- [sum_of_tones, '0', hilbert, '0']
- [hilbert, '0', out, '0']
- [tone_7000, '0', gain, '0']
- [gain, '0', sum_of_tones, '0']
metadata: {file_format: 1}
