options:
  parameters: {id: gbf_test_96, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_6400
  id: analog_sig_source_x
  parameters: {type: complex, freq: '6400', amp: '0.8', showports: 'True'}
- name: noise
  id: analog_noise_source_x
  parameters: {type: complex, amp: '0.2'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -1250/samp_rate, taps: '[1.0]'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '3750'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 9000})', period: '250'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: shifted.dat}
connections:
- [noise, '0', sum_of_tones, '1']
- [sum_of_tones, '0', channel, '0']
- [channel, '0', conj, '0']
- [conj, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [retune, strobe, tone_6400, cmd]
- [tone_6400, '0', throttle, '0']
- [throttle, '0', sum_of_tones, '0']
- [mixer, '0', out, '0']
metadata: {file_format: 1}
