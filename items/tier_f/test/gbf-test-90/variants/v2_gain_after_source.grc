options:
  parameters: {id: gbf_test_90, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_10700
  id: analog_sig_source_x
  parameters: {type: complex, freq: '10700'}
- name: tone_6200
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-6200', amp: '0.5'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -2250/samp_rate, taps: '[1.0]'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '3000'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '3', decim: '2'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: resampled.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: complex, const: '0.25'}
connections:
- [tone_6200, '0', sum_of_tones, '1']
- [sum_of_tones, '0', channel, '0']
- [channel, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', conj, '0']
- [conj, '0', resampler, '0']
- [resampler, '0', out, '0']
- [tone_10700, '0', gain, '0']
- [gain, '0', sum_of_tones, '0']
metadata: {file_format: 1}
