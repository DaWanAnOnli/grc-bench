options:
  parameters:
    id: demo_spec_an
    generate_options: no_gui
    output_language: python
blocks:
- name: fft_size
  id: variable
  parameters:
    value: '640'
- name: freq_offset
  id: variable
  parameters: {}
- name: samp_rate
  id: variable
  parameters:
    value: '64000'
- name: snr
  id: variable
  parameters:
    value: '-2'
- name: analog_noise_source_x_0
  id: analog_noise_source_x
  parameters:
    amp: math.pow(10.0,snr/20.0)
    seed: '42'
    type: complex
- name: analog_sig_source_x_0
  id: analog_sig_source_x
  parameters:
    amp: '0.5'
    freq: float(samp_rate)/float(fft_size)*31+freq_offset
    type: complex
- name: blocks_add_xx_0
  id: blocks_add_xx
  parameters:
    type: complex
- name: blocks_divide_xx_0
  id: blocks_divide_xx
  parameters:
    type: float
- name: blocks_nlog10_ff_0
  id: blocks_nlog10_ff
  parameters:
    n: '20'
- name: blocks_rms_xx_0
  id: blocks_rms_xx
  parameters:
    alpha: '0.0005'
    type: complex
- name: blocks_rms_xx_0_0
  id: blocks_rms_xx
  parameters:
    alpha: '0.0005'
    type: complex
- name: blocks_throttle2_0
  id: blocks_throttle2
  parameters:
    limit: auto
    type: complex
- name: imp0
  id: import
  parameters:
    imports: import math
- name: qtgui_freq_sink_x_0_0
  id: blocks_file_sink
  parameters:
    file: qtgui_freq_sink_x_0_0.dat
    type: complex
- name: qtgui_number_sink_0_0
  id: blocks_file_sink
  parameters:
    file: qtgui_number_sink_0_0.dat
    type: float
- name: qtgui_number_sink_signal_amplitude_0
  id: blocks_file_sink
  parameters:
    file: qtgui_number_sink_signal_amplitude_0.dat
    type: float
- name: qtgui_number_sink_snr_0
  id: blocks_file_sink
  parameters:
    file: qtgui_number_sink_snr_0.dat
    type: float
- name: channel_lpf
  id: low_pass_filter
  parameters:
    type: fir_filter_ccf
    cutoff_freq: 6e3
    width: 1.5e3
    win: window.WIN_BLACKMAN
- name: keep_one_in_4
  id: blocks_keep_one_in_n
  parameters:
    type: complex
    n: '4'
connections:
- [analog_noise_source_x_0, '0', blocks_add_xx_0, '1']
- [analog_noise_source_x_0, '0', blocks_rms_xx_0, '0']
- [analog_sig_source_x_0, '0', blocks_add_xx_0, '0']
- [analog_sig_source_x_0, '0', blocks_rms_xx_0_0, '0']
- [blocks_add_xx_0, '0', blocks_throttle2_0, '0']
- [blocks_divide_xx_0, '0', blocks_nlog10_ff_0, '0']
- [blocks_nlog10_ff_0, '0', qtgui_number_sink_snr_0, '0']
- [blocks_rms_xx_0, '0', blocks_divide_xx_0, '1']
- [blocks_rms_xx_0, '0', qtgui_number_sink_0_0, '0']
- [blocks_rms_xx_0_0, '0', blocks_divide_xx_0, '0']
- [blocks_rms_xx_0_0, '0', qtgui_number_sink_signal_amplitude_0, '0']
- [blocks_throttle2_0, '0', channel_lpf, '0']
- [channel_lpf, '0', keep_one_in_4, '0']
- [keep_one_in_4, '0', qtgui_freq_sink_x_0_0, '0']
metadata:
  file_format: 1
