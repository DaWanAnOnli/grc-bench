options:
  parameters: {id: gbf_test_118, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_7400
  id: analog_sig_source_x
  parameters: {type: complex, freq: '7400'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-4750'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -2000/samp_rate, taps: '[1.0]'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
- name: phase
  id: blocks_complex_to_arg
  parameters: {}
- name: out_b
  id: blocks_file_sink
  parameters: {type: float, file: second_phase.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: complex, const: '0.5'}
connections:
- [lo, '0', mixer, '1']
- [mixer, '0', channel, '0']
- [channel, '0', out, '0']
- [channel, '0', phase, '0']
- [phase, '0', out_b, '0']
- [tone_7400, '0', gain, '0']
- [gain, '0', mixer, '0']
metadata: {file_format: 1}
