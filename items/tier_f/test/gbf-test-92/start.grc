options:
  parameters: {id: gbf_test_92, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_3800
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '-3800', amp: '0.5',
    offset: '0'}
- name: tone_2600
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '2600', amp: '1',
    offset: '0'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex, num_inputs: '2'}
- name: conj
  id: blocks_conjugate_cc_x
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat, append: 'False', unbuffered: 'False', vlen: '1'}
connections:
- [tone_3800, '0', sum_of_tones, '0']
- [tone_2600, '0', sum_of_tones, '1']
- [sum_of_tones, '0', conj, '0']
- [conj, '0', out, '0']
metadata: {file_format: 1}
