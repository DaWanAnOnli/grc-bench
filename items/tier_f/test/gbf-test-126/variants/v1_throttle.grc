options:
  parameters: {id: gbf_test_126, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_3700
  id: analog_sig_source_x
  parameters: {type: complex, freq: '3700'}
- name: tone_12700
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-12700'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: lpf
  id: low_pass_filter
  parameters: {type: fir_filter_ccf, cutoff_freq: '8200', width: '400'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: agc
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-2, reference: '0.5', gain: '1'}
- name: conj_2
  id: blocks_conjugate_cc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat}
- name: rate_limit
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
connections:
- [tone_3700, '0', sum_of_tones, '0']
- [tone_12700, '0', sum_of_tones, '1']
- [sum_of_tones, '0', lpf, '0']
- [lpf, '0', conj, '0']
- [conj, '0', agc, '0']
- [agc, '0', conj_2, '0']
- [conj_2, '0', rate_limit, '0']
- [rate_limit, '0', out, '0']
metadata: {file_format: 1}
