options:
  parameters: {id: gbf_test_126, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_3700
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '3700', amp: '1',
    offset: '0'}
- name: tone_12700
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '-12700', amp: '1',
    offset: '0'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex, num_inputs: '2'}
- name: lpf
  id: low_pass_filter
  parameters: {type: fir_filter_ccf, decim: '1', gain: '1', samp_rate: samp_rate, cutoff_freq: '8200',
    width: '400', win: window.WIN_HAMMING, beta: '6.76'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: agc
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-2, reference: '0.5', gain: '1', max_gain: '65536'}
- name: conj_2
  id: blocks_conjugate_cc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat, append: 'False', unbuffered: 'False', vlen: '1'}
connections:
- [tone_3700, '0', sum_of_tones, '0']
- [tone_12700, '0', sum_of_tones, '1']
- [sum_of_tones, '0', lpf, '0']
- [lpf, '0', conj, '0']
- [conj, '0', agc, '0']
- [conj_2, '0', out, '0']
metadata: {file_format: 1}
