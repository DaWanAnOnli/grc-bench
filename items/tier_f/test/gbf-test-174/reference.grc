options:
  parameters: {id: gbf_test_174, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_1
  id: analog_sig_source_x
  parameters: {type: float, freq: '3200', amp: '0.25'}
- name: tone_2
  id: analog_sig_source_x
  parameters: {type: float, freq: '1700', amp: '0.4'}
- name: noise
  id: analog_noise_source_x
  parameters: {type: float, amp: '0.05'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float, num_inputs: '3'}
- name: hpf
  id: high_pass_filter
  parameters: {type: fir_filter_fff, cutoff_freq: '2450', width: '400'}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: filtered.dat}
connections:
- [tone_1, '0', sum_of_tones, '0']
- [tone_2, '0', sum_of_tones, '1']
- [noise, '0', sum_of_tones, '2']
- [sum_of_tones, '0', hpf, '0']
- [hpf, '0', out, '0']
metadata: {file_format: 1}
