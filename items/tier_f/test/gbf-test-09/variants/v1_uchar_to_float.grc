options:
  parameters: {id: sawtooth_peaks, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: saw_freq
  id: variable
  parameters: {value: '600'}
- name: offset
  id: variable
  parameters: {value: '0.25'}
- name: factor
  id: variable
  parameters: {value: '0.2'}
- name: alpha
  id: variable
  parameters: {value: '0.002'}
- name: lookahead
  id: variable
  parameters: {value: int(samp_rate/saw_freq/1.1)}
- name: analog_sig_source_x_0
  id: analog_sig_source_x
  parameters: {type: float, waveform: analog.GR_SAW_WAVE, freq: saw_freq, amp: '1.5', offset: offset}
- name: blocks_peak_detector2_fb_0
  id: blocks_peak_detector2_fb
  parameters: {threshold_factor_rise: factor, look_ahead: lookahead, alpha: alpha}
- name: blocks_uchar_to_float_0
  id: blocks_uchar_to_float
  parameters: {}
- name: blocks_file_sink_0
  id: blocks_file_sink
  parameters: {type: float, file: peaks.dat}
- name: blocks_file_sink_1
  id: blocks_file_sink
  parameters: {type: float, file: average.dat}
connections:
- [analog_sig_source_x_0, '0', blocks_peak_detector2_fb_0, '0']
- [blocks_peak_detector2_fb_0, '0', blocks_uchar_to_float_0, '0']
- [blocks_uchar_to_float_0, '0', blocks_file_sink_0, '0']
- [blocks_peak_detector2_fb_0, '1', blocks_file_sink_1, '0']
metadata: {file_format: 1}
