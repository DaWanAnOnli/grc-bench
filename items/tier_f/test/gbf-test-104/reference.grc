options:
  parameters: {id: gbf_test_104, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_1500
  id: analog_sig_source_x
  parameters: {type: complex, freq: '1500', amp: '0.5', showports: 'True'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 500/samp_rate, taps: '[1.0]'}
- name: agc
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-2, reference: '1', gain: '1'}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 1000})', period: '250'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: levelled.dat}
connections:
- [conj, '0', channel, '0']
- [channel, '0', agc, '0']
- [retune, strobe, tone_1500, cmd]
- [tone_1500, '0', throttle, '0']
- [throttle, '0', conj, '0']
- [agc, '0', out, '0']
metadata: {file_format: 1}
