options:
  parameters: {id: gbf_test_125, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_2500
  id: analog_sig_source_x
  parameters: {type: float, freq: '2500', amp: '0.6'}
- name: tone_8700
  id: analog_sig_source_x
  parameters: {type: float, freq: '8700', amp: '0.8'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float}
- name: hpf
  id: high_pass_filter
  parameters: {type: fir_filter_fff, cutoff_freq: '5600', width: '400'}
- name: fm_mod
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: 2*math.pi*1000/samp_rate}
- name: fm_demod
  id: analog_quadrature_demod_cf
  parameters: {gain: samp_rate/(2*math.pi*1000)}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -1250/samp_rate, taps: '[1.0]'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
connections:
- [tone_2500, '0', sum_of_tones, '0']
- [tone_8700, '0', sum_of_tones, '1']
- [sum_of_tones, '0', hpf, '0']
- [hpf, '0', fm_mod, '0']
- [fm_mod, '0', fm_demod, '0']
- [fm_demod, '0', hilbert, '0']
- [hilbert, '0', channel, '0']
- [channel, '0', out, '0']
metadata: {file_format: 1}
