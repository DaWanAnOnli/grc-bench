options:
  parameters: {id: gbf_test_160, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_1
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-10500', amp: '0.4'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -750/samp_rate, taps: '[1.0]'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: out_b
  id: blocks_file_sink
  parameters: {type: complex, file: second_mirrored.dat}
connections:
- [tone_1, '0', channel, '0']
- [channel, '0', out, '0']
- [tone_1, '0', conj, '0']
- [conj, '0', out_b, '0']
metadata: {file_format: 1}
