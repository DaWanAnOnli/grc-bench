options:
  parameters: {id: gbf_test_82, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_7600
  id: analog_sig_source_x
  parameters: {type: float, freq: '7600', amp: '0.25'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -1250/samp_rate, taps: '[1.0]'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: out_b
  id: blocks_file_sink
  parameters: {type: complex, file: second_mirrored.dat}
- name: rate_limit
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
connections:
- [tone_7600, '0', hilbert, '0']
- [hilbert, '0', channel, '0']
- [channel, '0', out, '0']
- [channel, '0', conj, '0']
- [conj, '0', rate_limit, '0']
- [rate_limit, '0', out_b, '0']
metadata: {file_format: 1}
