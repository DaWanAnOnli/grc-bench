options:
  parameters: {id: fm_loop_v7, generate_options: no_gui}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '40000'}
- name: audio_rate
  id: variable
  parameters: {value: '8000'}
- name: deviation
  id: variable
  parameters: {value: '2500'}
- name: rx_scale
  id: variable
  parameters: {value: '1000'}
- name: tone
  id: analog_sig_source_x
  parameters: {type: float, samp_rate: audio_rate, freq: '1200'}
- name: upsample
  id: rational_resampler_xxx
  parameters: {type: fff, interp: int(samp_rate/audio_rate)}
- name: fm_mod
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: -2*math.pi*deviation/samp_rate}
- name: fm_iq
  id: blocks_file_sink
  parameters: {type: complex, file: fm_iq.dat}
- name: fm_demod
  id: analog_quadrature_demod_cf
  parameters: {gain: -samp_rate/(2*math.pi*rx_scale)}
- name: audio_lpf
  id: low_pass_filter
  parameters: {type: fir_filter_fff, decim: int(samp_rate/audio_rate), cutoff_freq: '3000', width: '1000'}
- name: recovered
  id: blocks_file_sink
  parameters: {type: float, file: recovered.dat}
- name: dcb
  id: dc_blocker_xx
  parameters: {type: ff}
- name: slow
  id: blocks_throttle2
  parameters: {type: complex, samples_per_second: '8000'}
connections:
- [tone, '0', upsample, '0']
- [upsample, '0', fm_mod, '0']
- [fm_demod, '0', audio_lpf, '0']
- [fm_mod, '0', slow, '0']
- [slow, '0', fm_iq, '0']
- [slow, '0', fm_demod, '0']
- [audio_lpf, '0', dcb, '0']
- [dcb, '0', recovered, '0']
metadata: {file_format: 1}
