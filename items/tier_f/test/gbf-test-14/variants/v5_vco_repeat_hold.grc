options:
  parameters: {id: fm_loop_v5, generate_options: no_gui}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '40000'}
- name: audio_rate
  id: variable
  parameters: {value: '8000'}
- name: tone
  id: analog_sig_source_x
  parameters: {type: float, samp_rate: audio_rate, freq: '1200'}
- name: hold
  id: blocks_repeat
  parameters: {type: float, interp: '5'}
- name: vco
  id: blocks_vco_c
  parameters: {samp_rate: samp_rate, sensitivity: 2*math.pi*2500, amplitude: '1'}
- name: iq
  id: blocks_file_sink
  parameters: {type: complex, file: fm_iq.dat}
- name: quad
  id: analog_quadrature_demod_cf
  parameters: {gain: samp_rate/(2*math.pi*1000)}
- name: aa
  id: low_pass_filter
  parameters: {type: fir_filter_fff, decim: '5', cutoff_freq: '3000', width: '1000'}
- name: audio
  id: blocks_file_sink
  parameters: {type: float, file: recovered.dat}
connections:
- [tone, '0', hold, '0']
- [hold, '0', vco, '0']
- [vco, '0', iq, '0']
- [vco, '0', quad, '0']
- [quad, '0', aa, '0']
- [aa, '0', audio, '0']
metadata: {file_format: 1}
