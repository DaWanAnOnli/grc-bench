options:
  parameters: {id: fm_loop_v2, generate_options: no_gui}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: 40e3}
- name: audio_fs
  id: variable
  parameters: {value: 8e3}
- name: max_dev
  id: variable
  parameters: {value: '2500'}
- name: tone_f
  id: variable
  parameters: {value: '1200'}
- name: imp
  id: import
  parameters: {imports: import math}
- name: tone_src
  id: analog_sig_source_x
  parameters: {type: float, samp_rate: audio_fs, freq: tone_f}
- name: interp
  id: interp_fir_filter_xxx
  parameters: {type: fff, interp: '5', taps: 'firdes.low_pass(5, samp_rate, 3000, 1000)'}
- name: modulator
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: 2*math.pi*max_dev/samp_rate}
- name: iq_file
  id: blocks_file_sink
  parameters: {type: complex, file: fm_iq.dat}
- name: demodulator
  id: analog_fm_demod_cf
  parameters: {chan_rate: samp_rate, audio_decim: '5', deviation: '1000', audio_pass: '3000', audio_stop: '3600',
    tau: '0'}
- name: audio_file
  id: blocks_file_sink
  parameters: {type: float, file: recovered.dat}
connections:
- [tone_src, '0', interp, '0']
- [interp, '0', modulator, '0']
- [modulator, '0', iq_file, '0']
- [modulator, '0', demodulator, '0']
- [demodulator, '0', audio_file, '0']
metadata: {file_format: 1}
