options:
  parameters: {id: fm_loop_v4, generate_options: no_gui}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '40000'}
- name: tone40
  id: analog_sig_source_x
  parameters: {type: float, freq: '1200', amp: '1.0'}
- name: fm
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: 2*math.pi*2500/samp_rate}
- name: iq_sink
  id: blocks_file_sink
  parameters: {type: complex, file: fm_iq.dat}
- name: disc
  id: analog_quadrature_demod_cf
  parameters: {gain: samp_rate/(2*math.pi*1000)}
- name: dec5
  id: low_pass_filter
  parameters: {type: fir_filter_fff, decim: '5', cutoff_freq: '3400', width: '600', win: window.WIN_HANN}
- name: audio_sink
  id: blocks_file_sink
  parameters: {type: float, file: recovered.dat}
connections:
- [tone40, '0', fm, '0']
- [fm, '0', iq_sink, '0']
- [fm, '0', disc, '0']
- [disc, '0', dec5, '0']
- [dec5, '0', audio_sink, '0']
metadata: {file_format: 1}
