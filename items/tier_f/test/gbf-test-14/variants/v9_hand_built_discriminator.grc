options:
  parameters: {id: fm_loop_v9, generate_options: no_gui}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '40000'}
- name: audio_rate
  id: variable
  parameters: {value: '8000'}
- name: deviation
  id: variable
  parameters: {value: '2500'}
- name: rx_scale
  id: variable
  parameters: {value: '1000'}
- name: tone
  id: analog_sig_source_x
  parameters: {type: float, samp_rate: audio_rate, freq: '1200'}
- name: upsample
  id: rational_resampler_xxx
  parameters: {type: fff, interp: int(samp_rate/audio_rate)}
- name: fm_mod
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: 2*math.pi*deviation/samp_rate}
- name: fm_iq
  id: blocks_file_sink
  parameters: {type: complex, file: fm_iq.dat}
- name: audio_lpf
  id: low_pass_filter
  parameters: {type: fir_filter_fff, decim: int(samp_rate/audio_rate), cutoff_freq: '3000', width: '1000'}
- name: recovered
  id: blocks_file_sink
  parameters: {type: float, file: recovered.dat}
- name: imp
  id: import
  parameters: {imports: import math}
- name: one_back
  id: blocks_delay
  parameters: {type: complex, delay: '1'}
- name: phase_step
  id: blocks_multiply_conjugate_cc
  parameters: {}
- name: angle
  id: blocks_complex_to_arg
  parameters: {}
- name: to_khz
  id: blocks_multiply_const_vxx
  parameters: {type: float, const: samp_rate/(2*math.pi*rx_scale)}
connections:
- [tone, '0', upsample, '0']
- [upsample, '0', fm_mod, '0']
- [fm_mod, '0', fm_iq, '0']
- [audio_lpf, '0', recovered, '0']
- [fm_mod, '0', phase_step, '0']
- [fm_mod, '0', one_back, '0']
- [one_back, '0', phase_step, '1']
- [phase_step, '0', angle, '0']
- [angle, '0', to_khz, '0']
- [to_khz, '0', audio_lpf, '0']
metadata: {file_format: 1}
