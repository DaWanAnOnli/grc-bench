options:
  parameters: {id: gbf_test_108, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_12200
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-12200', amp: '0.5'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -1500/samp_rate, taps: '[1.0]'}
- name: agc
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-2, reference: '1', gain: '1'}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '3', decim: '2'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat}
- name: rate_limit
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
connections:
- [tone_12200, '0', channel, '0']
- [channel, '0', agc, '0']
- [agc, '0', resampler, '0']
- [resampler, '0', conj, '0']
- [conj, '0', rate_limit, '0']
- [rate_limit, '0', out, '0']
metadata: {file_format: 1}
