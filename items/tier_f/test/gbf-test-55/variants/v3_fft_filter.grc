options:
  parameters: {id: gbf_test_55, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_1100
  id: analog_sig_source_x
  parameters: {type: float, freq: '1100', amp: '0.6'}
- name: tone_8700
  id: analog_sig_source_x
  parameters: {type: float, freq: '8700', amp: '0.25'}
- name: tone_4900
  id: analog_sig_source_x
  parameters: {type: float, freq: '4900', amp: '0.6'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float, num_inputs: '3'}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: fff, interp: '3', decim: '2'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: lpf
  id: fft_filter_xxx
  parameters: {type: ccf, taps: 'firdes.low_pass(1, samp_rate*3/2, 3000, 200)'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: filtered.dat}
- name: to_short
  id: blocks_float_to_short
  parameters: {scale: '1000'}
- name: to_float
  id: blocks_short_to_float
  parameters: {scale: '1000'}
- name: out_b
  id: blocks_file_sink
  parameters: {type: float, file: second_quantized.dat}
connections:
- [tone_1100, '0', sum_of_tones, '0']
- [tone_8700, '0', sum_of_tones, '1']
- [tone_4900, '0', sum_of_tones, '2']
- [sum_of_tones, '0', resampler, '0']
- [resampler, '0', hilbert, '0']
- [hilbert, '0', lpf, '0']
- [lpf, '0', out, '0']
- [resampler, '0', to_short, '0']
- [to_short, '0', to_float, '0']
- [to_float, '0', out_b, '0']
metadata: {file_format: 1}
