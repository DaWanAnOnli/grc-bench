options:
  parameters: {id: gbf_test_30, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_6000
  id: analog_sig_source_x
  parameters: {type: complex, freq: '6000', amp: '0.4'}
- name: tone_11000
  id: analog_sig_source_x
  parameters: {type: complex, freq: (5500)*2, amp: '0.6'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -2750/samp_rate, taps: '[1.0]'}
- name: channel_2
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 1750/samp_rate, taps: '[1.0]'}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '2'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: resampled.dat}
connections:
- [tone_6000, '0', sum_of_tones, '0']
- [tone_11000, '0', sum_of_tones, '1']
- [sum_of_tones, '0', channel, '0']
- [channel, '0', channel_2, '0']
- [channel_2, '0', resampler, '0']
- [resampler, '0', out, '0']
metadata: {file_format: 1}
