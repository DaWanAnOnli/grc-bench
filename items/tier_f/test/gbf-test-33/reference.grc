options:
  parameters: {id: gbf_test_33, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_2600
  id: analog_sig_source_x
  parameters: {type: complex, freq: '2600', amp: '0.6'}
- name: tone_7500
  id: analog_sig_source_x
  parameters: {type: complex, freq: '7500', amp: '0.8'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: conj_2
  id: blocks_conjugate_cc
  parameters: {}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '2000'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: shifted.dat}
connections:
- [tone_2600, '0', sum_of_tones, '0']
- [tone_7500, '0', sum_of_tones, '1']
- [sum_of_tones, '0', conj, '0']
- [conj, '0', conj_2, '0']
- [conj_2, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', out, '0']
metadata: {file_format: 1}
