options:
  parameters: {id: gbf_test_74, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_11300
  id: analog_sig_source_x
  parameters: {type: float, freq: '11300', amp: '0.6'}
- name: tone_3100
  id: analog_sig_source_x
  parameters: {type: float, freq: '3100', amp: '0.8'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '2'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 500/(samp_rate*2/1), taps: '[1.0]'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
connections:
- [tone_11300, '0', sum_of_tones, '0']
- [tone_3100, '0', sum_of_tones, '1']
- [sum_of_tones, '0', hilbert, '0']
- [hilbert, '0', resampler, '0']
- [resampler, '0', channel, '0']
- [channel, '0', out, '0']
metadata: {file_format: 1}
