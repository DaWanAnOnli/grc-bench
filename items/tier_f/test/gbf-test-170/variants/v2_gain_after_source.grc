options:
  parameters: {id: gbf_test_170, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_1
  id: analog_sig_source_x
  parameters: {type: float, freq: '6300'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -2750/samp_rate, taps: '[1.0]'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '2'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: resampled.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: float, const: '0.25'}
connections:
- [hilbert, '0', channel, '0']
- [channel, '0', conj, '0']
- [conj, '0', resampler, '0']
- [resampler, '0', out, '0']
- [tone_1, '0', gain, '0']
- [gain, '0', hilbert, '0']
metadata: {file_format: 1}
