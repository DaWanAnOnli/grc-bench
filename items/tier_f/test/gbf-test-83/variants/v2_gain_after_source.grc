options:
  parameters: {id: gbf_test_83, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_8800
  id: analog_sig_source_x
  parameters: {type: complex, freq: '8800'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -1500/samp_rate, taps: '[1.0]'}
- name: channel_2
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -500/samp_rate, taps: '[1.0]'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: complex, const: '0.8'}
connections:
- [channel, '0', channel_2, '0']
- [channel_2, '0', out, '0']
- [tone_8800, '0', gain, '0']
- [gain, '0', channel, '0']
metadata: {file_format: 1}
