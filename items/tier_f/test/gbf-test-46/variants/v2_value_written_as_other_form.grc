options:
  parameters: {id: gbf_test_46, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_7200
  id: analog_sig_source_x
  parameters: {type: float, freq: '7200', amp: '0.5'}
- name: tone_4800
  id: analog_sig_source_x
  parameters: {type: float, freq: '4800', amp: '0.25'}
- name: tone_2600
  id: analog_sig_source_x
  parameters: {type: float, freq: '2600', amp: '0.8'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float, num_inputs: '3'}
- name: lpf
  id: low_pass_filter
  parameters: {type: fir_filter_fff, cutoff_freq: '6000', width: '400'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '1.500000e+03'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: shifted.dat}
connections:
- [tone_7200, '0', sum_of_tones, '0']
- [tone_4800, '0', sum_of_tones, '1']
- [tone_2600, '0', sum_of_tones, '2']
- [sum_of_tones, '0', lpf, '0']
- [lpf, '0', hilbert, '0']
- [hilbert, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', out, '0']
metadata: {file_format: 1}
