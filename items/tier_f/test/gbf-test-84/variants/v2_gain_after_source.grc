options:
  parameters: {id: gbf_test_84, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_4400
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-4400', showports: 'True'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 2000/samp_rate, taps: '[1.0]'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '5250'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': -6200})', period: '250'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: shifted.dat}
- name: magnitude
  id: blocks_complex_to_mag
  parameters: {}
- name: out_b
  id: blocks_file_sink
  parameters: {type: float, file: second_level.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: complex, const: '0.25'}
connections:
- [channel, '0', conj, '0']
- [conj, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [retune, strobe, tone_4400, cmd]
- [throttle, '0', channel, '0']
- [mixer, '0', out, '0']
- [mixer, '0', magnitude, '0']
- [magnitude, '0', out_b, '0']
- [tone_4400, '0', gain, '0']
- [gain, '0', throttle, '0']
metadata: {file_format: 1}
