options:
  parameters: {id: gbf_test_76, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_1600
  id: analog_sig_source_x
  parameters: {type: float, freq: '1600', amp: '0.4', showports: 'True'}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: fff, interp: '3', decim: '2'}
- name: to_short
  id: blocks_float_to_short
  parameters: {scale: '10'}
- name: to_float
  id: blocks_short_to_float
  parameters: {scale: '10'}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 2200})', period: '100'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: float, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: quantized.dat}
- name: rate_limit
  id: blocks_throttle2
  parameters: {type: float, limit: auto}
connections:
- [resampler, '0', to_short, '0']
- [to_short, '0', to_float, '0']
- [retune, strobe, tone_1600, cmd]
- [tone_1600, '0', throttle, '0']
- [throttle, '0', resampler, '0']
- [to_float, '0', rate_limit, '0']
- [rate_limit, '0', out, '0']
metadata: {file_format: 1}
