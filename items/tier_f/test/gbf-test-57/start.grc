options:
  parameters: {id: gbf_test_57, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_2700
  id: analog_sig_source_x
  parameters: {type: complex, freq: '2700', amp: '0.5', showports: 'True'}
- name: noise
  id: analog_noise_source_x
  parameters: {type: complex, amp: '0.05'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '3', decim: '2'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate*3/2, freq: '-3750'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 5600})', period: '200'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: shifted.dat}
connections:
- [noise, '0', sum_of_tones, '1']
- [sum_of_tones, '0', resampler, '0']
- [resampler, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [retune, strobe, tone_2700, cmd]
- [tone_2700, '0', throttle, '0']
- [throttle, '0', sum_of_tones, '0']
- [mixer, '0', out, '0']
metadata: {file_format: 1}
