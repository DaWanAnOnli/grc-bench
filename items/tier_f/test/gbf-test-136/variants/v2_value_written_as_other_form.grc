options:
  parameters: {id: gbf_test_136, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_6700
  id: analog_sig_source_x
  parameters: {type: complex, freq: '6700'}
- name: tone_2800
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-2800'}
- name: tone_8500
  id: analog_sig_source_x
  parameters: {type: complex, freq: '8500', amp: '0.6'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex, num_inputs: '3'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -500/samp_rate, taps: '[1.0]'}
- name: lpf
  id: low_pass_filter
  parameters: {type: fir_filter_ccf, cutoff_freq: '4750', width: '300'}
- name: agc
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-2, reference: '2.000000e+00', gain: '1'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat}
connections:
- [tone_6700, '0', sum_of_tones, '0']
- [tone_2800, '0', sum_of_tones, '1']
- [tone_8500, '0', sum_of_tones, '2']
- [sum_of_tones, '0', channel, '0']
- [channel, '0', lpf, '0']
- [lpf, '0', agc, '0']
- [agc, '0', conj, '0']
- [conj, '0', out, '0']
metadata: {file_format: 1}
