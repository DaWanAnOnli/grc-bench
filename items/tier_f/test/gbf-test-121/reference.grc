options:
  parameters: {id: gbf_test_121, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_7400
  id: analog_sig_source_x
  parameters: {type: complex, freq: '7400', amp: '0.6'}
- name: noise
  id: analog_noise_source_x
  parameters: {type: complex, amp: '0.2'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 2750/samp_rate, taps: '[1.0]'}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '3', decim: '2'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate*3/2, freq: '2250'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: shifted.dat}
connections:
- [tone_7400, '0', sum_of_tones, '0']
- [noise, '0', sum_of_tones, '1']
- [sum_of_tones, '0', conj, '0']
- [conj, '0', channel, '0']
- [channel, '0', resampler, '0']
- [resampler, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', out, '0']
metadata: {file_format: 1}
