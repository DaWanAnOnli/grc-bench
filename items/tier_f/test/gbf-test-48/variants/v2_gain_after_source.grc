options:
  parameters: {id: gbf_test_48, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_2500
  id: analog_sig_source_x
  parameters: {type: complex, freq: '2500'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 1000/samp_rate, taps: '[1.0]'}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '3', decim: '2'}
- name: channel_2
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -1500/(samp_rate*3/2), taps: '[1.0]'}
- name: agc
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-2, reference: '0.5', gain: '1'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: levelled.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: complex, const: '0.6'}
connections:
- [channel, '0', resampler, '0']
- [resampler, '0', channel_2, '0']
- [channel_2, '0', agc, '0']
- [agc, '0', out, '0']
- [tone_2500, '0', gain, '0']
- [gain, '0', channel, '0']
metadata: {file_format: 1}
