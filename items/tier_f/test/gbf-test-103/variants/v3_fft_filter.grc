options:
  parameters: {id: gbf_test_103, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_8300
  id: analog_sig_source_x
  parameters: {type: complex, freq: '8300'}
- name: tone_2200
  id: analog_sig_source_x
  parameters: {type: complex, freq: '2200', amp: '0.6'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: lpf
  id: fft_filter_xxx
  parameters: {type: ccf, taps: 'firdes.low_pass(1, samp_rate, 5250, 400)'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-1250'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: lo_2
  id: analog_sig_source_x
  parameters: {type: complex, freq: '4500'}
- name: mixer_2
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: shifted.dat}
- name: agc
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-2, reference: '2', gain: '1'}
- name: out_b
  id: blocks_file_sink
  parameters: {type: complex, file: second_levelled.dat}
connections:
- [tone_8300, '0', sum_of_tones, '0']
- [tone_2200, '0', sum_of_tones, '1']
- [sum_of_tones, '0', lpf, '0']
- [lpf, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', mixer_2, '0']
- [lo_2, '0', mixer_2, '1']
- [mixer_2, '0', out, '0']
- [mixer_2, '0', agc, '0']
- [agc, '0', out_b, '0']
metadata: {file_format: 1}
