options:
  parameters: {id: gbf_test_58, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_4400
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-4400', amp: '0.4'}
- name: tone_6800
  id: analog_sig_source_x
  parameters: {type: complex, freq: '8800', amp: '0.25'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat}
connections:
- [tone_4400, '0', sum_of_tones, '0']
- [tone_6800, '0', sum_of_tones, '1']
- [sum_of_tones, '0', conj, '0']
- [conj, '0', out, '0']
metadata: {file_format: 1}
