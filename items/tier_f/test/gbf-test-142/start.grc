options:
  parameters: {id: gbf_test_142, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_1
  id: analog_sig_source_x
  parameters: {type: float, freq: '11600'}
- name: tone_2
  id: analog_sig_source_x
  parameters: {type: float, freq: '5700', amp: '0.5'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: analytic.dat}
connections:
- [tone_1, '0', sum_of_tones, '0']
- [tone_2, '0', sum_of_tones, '1']
- [sum_of_tones, '0', hilbert, '0']
- [hilbert, '0', out, '0']
metadata: {file_format: 1}
