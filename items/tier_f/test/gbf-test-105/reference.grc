options:
  parameters: {id: gbf_test_105, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_5600
  id: analog_sig_source_x
  parameters: {type: float, freq: '5600', showports: 'True'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 2250/samp_rate, taps: '[1.0]'}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 3900})', period: '100'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: float, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
connections:
- [hilbert, '0', conj, '0']
- [conj, '0', channel, '0']
- [retune, strobe, tone_5600, cmd]
- [tone_5600, '0', throttle, '0']
- [throttle, '0', hilbert, '0']
- [channel, '0', out, '0']
metadata: {file_format: 1}
