options:
  parameters: {id: gbf_dev_35, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_4000
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '4000', amp: '0.25',
    offset: '0'}
- name: channel
  id: channels_channel_model_x
  parameters: {noise_voltage: '0', freq_offset: 1250/samp_rate, epsilon: '1.0', taps: '[1.0]', seed: '0',
    block_tags: 'False'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat, append: 'False', unbuffered: 'False', vlen: '1'}
connections:
- [tone_4000, '0', channel, '0']
- [channel, '0', conj, '0']
- [conj, '0', out, '0']
metadata: {file_format: 1}
