options:
  parameters: {id: rayleigh_envelope, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: noise
  id: analog_noise_source_x
  parameters: {type: complex, amp: '0.8', seed: '42', noise_type: analog.GR_GAUSSIAN}
- name: thr
  id: blocks_throttle2
  parameters: {type: complex}
- name: mag
  id: blocks_complex_to_mag
  parameters: {}
- name: snk
  id: blocks_file_sink
  parameters: {type: float, file: envelope.dat}
connections:
- [noise, '0', thr, '0']
- [thr, '0', mag, '0']
- [mag, '0', snk, '0']
metadata: {file_format: 1}
