options:
  parameters: {id: fading_channel, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: zeros
  id: blocks_null_source
  parameters: {type: complex}
- name: chan
  id: channels_channel_model
  parameters: {noise_voltage: '0.8', taps: '[1.0]', seed: '3'}
- name: thr
  id: blocks_throttle2
  parameters: {type: complex}
- name: mag
  id: blocks_complex_to_mag
  parameters: {}
- name: snk
  id: blocks_file_sink
  parameters: {type: float, file: envelope.dat}
connections:
- [zeros, '0', chan, '0']
- [chan, '0', thr, '0']
- [thr, '0', mag, '0']
- [mag, '0', snk, '0']
metadata: {file_format: 1}
