options:
  parameters:
    id: stream_mux_demo
    generate_options: no_gui
    output_language: python
blocks:
- name: header_word
  id: variable
  parameters:
    value: '[-1, -2]'
- name: n_from_a
  id: variable
  parameters:
    value: '4'
- name: n_from_b
  id: variable
  parameters:
    value: '3'
- name: samp_rate
  id: variable
  parameters:
    value: '32000'
- name: tag0
  id: variable_tag_object
  parameters:
    key: pmt.intern("key0")
    value: pmt.intern("value0")
- name: tag1
  id: variable_tag_object
  parameters:
    key: pmt.intern("key1")
    value: pmt.intern("value1")
- name: blocks_stream_mux_0
  id: blocks_stream_mux
  parameters:
    lengths: '[len(header_word), n_from_a, n_from_b]'
    type: float
    num_inputs: '3'
- name: blocks_throttle2_0
  id: blocks_throttle2
  parameters:
    limit: auto
    type: float
- name: blocks_vector_source_x_0
  id: blocks_vector_source_x
  parameters:
    tags: '[tag0]'
    type: float
    vector: (1, 2, 3, 4, 8, 9, 10, 11)
- name: blocks_vector_source_x_0_0
  id: blocks_vector_source_x
  parameters:
    tags: '[tag1]'
    type: float
    vector: (5, 6, 7, 12, 13, 14)
- name: mux_out
  id: blocks_file_sink
  parameters:
    file: mux_out.dat
    type: float
- name: stream_a
  id: blocks_file_sink
  parameters:
    file: stream_a.dat
    type: float
- name: stream_b
  id: blocks_file_sink
  parameters:
    file: stream_b.dat
    type: float
- name: hdr
  id: blocks_vector_source_x
  parameters:
    type: float
    vector: header_word
connections:
- [blocks_stream_mux_0, '0', blocks_throttle2_0, '0']
- [blocks_throttle2_0, '0', mux_out, '0']
- [blocks_vector_source_x_0, '0', stream_a, '0']
- [blocks_vector_source_x_0_0, '0', stream_b, '0']
- [hdr, '0', blocks_stream_mux_0, '0']
- [blocks_vector_source_x_0, '0', blocks_stream_mux_0, '1']
- [blocks_vector_source_x_0_0, '0', blocks_stream_mux_0, '2']
metadata:
  file_format: 1
