options:
  parameters:
    id: stream_mux_demo
    generate_options: no_gui
    output_language: python
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: '32000'
- name: tag0
  id: variable_tag_object
  parameters:
    key: pmt.intern("key0")
    value: pmt.intern("value0")
- name: tag1
  id: variable_tag_object
  parameters:
    key: pmt.intern("key1")
    value: pmt.intern("value1")
- name: blocks_stream_mux_0
  id: blocks_stream_mux
  parameters:
    lengths: '[1, 1, 4, 3]'
    type: float
    num_inputs: '4'
- name: blocks_throttle2_0
  id: blocks_throttle2
  parameters:
    limit: auto
    type: float
- name: blocks_vector_source_x_0
  id: blocks_vector_source_x
  parameters:
    tags: '[tag0]'
    type: float
    vector: (1, 2, 3, 4, 8, 9, 10, 11)
- name: blocks_vector_source_x_0_0
  id: blocks_vector_source_x
  parameters:
    tags: '[tag1]'
    type: float
    vector: (5, 6, 7, 12, 13, 14)
- name: mux_out
  id: blocks_file_sink
  parameters:
    file: mux_out.dat
    type: float
- name: stream_a
  id: blocks_file_sink
  parameters:
    file: stream_a.dat
    type: float
- name: stream_b
  id: blocks_file_sink
  parameters:
    file: stream_b.dat
    type: float
- name: hdr_first
  id: analog_const_source_x
  parameters:
    type: float
    const: '-1'
- name: hdr_second
  id: analog_const_source_x
  parameters:
    type: float
    const: '-2.0'
connections:
- [blocks_stream_mux_0, '0', blocks_throttle2_0, '0']
- [blocks_throttle2_0, '0', mux_out, '0']
- [blocks_vector_source_x_0, '0', stream_a, '0']
- [blocks_vector_source_x_0_0, '0', stream_b, '0']
- [hdr_first, '0', blocks_stream_mux_0, '0']
- [hdr_second, '0', blocks_stream_mux_0, '1']
- [blocks_vector_source_x_0, '0', blocks_stream_mux_0, '2']
- [blocks_vector_source_x_0_0, '0', blocks_stream_mux_0, '3']
metadata:
  file_format: 1
