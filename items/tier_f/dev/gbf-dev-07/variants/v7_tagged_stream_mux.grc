options:
  parameters:
    id: stream_mux_demo
    generate_options: no_gui
    output_language: python
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: '32000'
- name: tag0
  id: variable_tag_object
  parameters:
    key: pmt.intern("key0")
    value: pmt.intern("value0")
- name: tag1
  id: variable_tag_object
  parameters:
    key: pmt.intern("key1")
    value: pmt.intern("value1")
- name: blocks_throttle2_0
  id: blocks_throttle2
  parameters:
    limit: auto
    type: float
- name: blocks_vector_source_x_0
  id: blocks_vector_source_x
  parameters:
    tags: '[tag0]'
    type: float
    vector: (1, 2, 3, 4, 8, 9, 10, 11)
- name: blocks_vector_source_x_0_0
  id: blocks_vector_source_x
  parameters:
    tags: '[tag1]'
    type: float
    vector: (5, 6, 7, 12, 13, 14)
- name: mux_out
  id: blocks_file_sink
  parameters:
    file: mux_out.dat
    type: float
- name: stream_a
  id: blocks_file_sink
  parameters:
    file: stream_a.dat
    type: float
- name: stream_b
  id: blocks_file_sink
  parameters:
    file: stream_b.dat
    type: float
- name: hdr_words
  id: blocks_vector_source_x
  parameters:
    type: float
    vector: (-1, -2)
- name: pkt_hdr
  id: blocks_stream_to_tagged_stream
  parameters:
    type: float
    packet_len: '2'
    len_tag_key: '"frame_len"'
- name: pkt_a
  id: blocks_stream_to_tagged_stream
  parameters:
    type: float
    packet_len: '4'
    len_tag_key: '"frame_len"'
- name: pkt_b
  id: blocks_stream_to_tagged_stream
  parameters:
    type: float
    packet_len: '3'
    len_tag_key: '"frame_len"'
- name: frame_tsmux
  id: blocks_tagged_stream_mux
  parameters:
    type: float
    ninputs: '3'
    lengthtagname: '"frame_len"'
connections:
- [blocks_throttle2_0, '0', mux_out, '0']
- [blocks_vector_source_x_0, '0', stream_a, '0']
- [blocks_vector_source_x_0_0, '0', stream_b, '0']
- [hdr_words, '0', pkt_hdr, '0']
- [blocks_vector_source_x_0, '0', pkt_a, '0']
- [blocks_vector_source_x_0_0, '0', pkt_b, '0']
- [pkt_hdr, '0', frame_tsmux, '0']
- [pkt_a, '0', frame_tsmux, '1']
- [pkt_b, '0', frame_tsmux, '2']
- [frame_tsmux, '0', blocks_throttle2_0, '0']
metadata:
  file_format: 1
