options:
  parameters: {id: gbf_dev_40, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_600
  id: analog_sig_source_x
  parameters: {type: float, freq: '600', amp: '0.25'}
- name: tone_4700
  id: analog_sig_source_x
  parameters: {type: float, freq: '4700'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: fff, interp: '3', decim: '2'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 2250/(samp_rate*3/2), taps: '[1.0]'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
connections:
- [tone_600, '0', sum_of_tones, '0']
- [tone_4700, '0', sum_of_tones, '1']
- [sum_of_tones, '0', resampler, '0']
- [resampler, '0', hilbert, '0']
- [hilbert, '0', conj, '0']
- [conj, '0', channel, '0']
- [channel, '0', out, '0']
metadata: {file_format: 1}
