options:
  parameters: {id: gbf_dev_20, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_7200
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-7200'}
- name: tone_9300
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-9300'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 750/samp_rate, taps: '[1.0]'}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '2'}
- name: channel_2
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -1250/(samp_rate*2/1), taps: '[1.0]'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate*2/1, freq: '15250'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: shifted.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: complex, const: '0.8'}
connections:
- [tone_7200, '0', sum_of_tones, '0']
- [sum_of_tones, '0', channel, '0']
- [channel, '0', resampler, '0']
- [resampler, '0', channel_2, '0']
- [channel_2, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', out, '0']
- [tone_9300, '0', gain, '0']
- [gain, '0', sum_of_tones, '1']
metadata: {file_format: 1}
