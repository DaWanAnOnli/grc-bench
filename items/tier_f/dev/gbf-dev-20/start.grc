options:
  parameters: {id: gbf_dev_20, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_7200
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '-7200', amp: '1',
    offset: '0'}
- name: tone_9300
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '-9300', amp: '0.8',
    offset: '0'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex, num_inputs: '2'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 750/samp_rate, epsilon: '1.0', taps: '[1.0]', seed: '0',
    block_tags: 'False'}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '2', decim: '1', taps: '[]', fbw: '0'}
- name: channel_2
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -1250/(samp_rate*2/1), epsilon: '1.0', taps: '[1.0]',
    seed: '0', block_tags: 'False'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate*2/1, waveform: analog.GR_COS_WAVE, freq: '15250', amp: '1',
    offset: '0'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex, num_inputs: '2'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: shifted.dat, append: 'False', unbuffered: 'False', vlen: '1'}
connections:
- [tone_7200, '0', sum_of_tones, '0']
- [tone_9300, '0', sum_of_tones, '1']
- [sum_of_tones, '0', channel, '0']
- [channel, '0', resampler, '0']
- [channel_2, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', out, '0']
metadata: {file_format: 1}
