options:
  parameters: {id: gbf_dev_33, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_7000
  id: analog_sig_source_x
  parameters: {type: float, freq: '7000', amp: '0.4'}
- name: tone_1600
  id: analog_sig_source_x
  parameters: {type: float, freq: '1600', amp: '0.25'}
- name: tone_3600
  id: analog_sig_source_x
  parameters: {type: float, freq: '3600', amp: '0.5'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float, num_inputs: '3'}
- name: lpf
  id: low_pass_filter
  parameters: {type: fir_filter_fff, cutoff_freq: '5300', width: '300'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat}
connections:
- [tone_7000, '0', sum_of_tones, '0']
- [tone_1600, '0', sum_of_tones, '1']
- [tone_3600, '0', sum_of_tones, '2']
- [sum_of_tones, '0', lpf, '0']
- [lpf, '0', hilbert, '0']
- [hilbert, '0', conj, '0']
- [conj, '0', out, '0']
metadata: {file_format: 1}
