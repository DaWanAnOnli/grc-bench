options:
  parameters: {id: ssb_phasing_tx, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: audio_rate
  id: variable
  parameters: {value: '8000'}
- name: carrier_freq
  id: variable
  parameters: {value: '10000'}
- name: tone_700
  id: analog_sig_source_x
  parameters: {type: float, samp_rate: audio_rate, freq: '700', amp: '0.4'}
- name: tone_2400
  id: analog_sig_source_x
  parameters: {type: float, samp_rate: audio_rate, freq: '2400', amp: '0.25'}
- name: audio_sum
  id: blocks_add_xx
  parameters: {type: float}
- name: audio_out
  id: blocks_file_sink
  parameters: {type: float, file: audio.dat}
- name: upsample
  id: rational_resampler_xxx
  parameters: {type: fff, interp: int(samp_rate/audio_rate)}
- name: hilbert
  id: hilbert_fc
  parameters: {num_taps: '257'}
- name: carrier
  id: analog_sig_source_x
  parameters: {type: complex, freq: carrier_freq}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: to_real
  id: blocks_complex_to_real
  parameters: {}
- name: ssb_out
  id: blocks_file_sink
  parameters: {type: float, file: ssb.dat}
connections:
- [tone_700, '0', audio_sum, '0']
- [tone_2400, '0', audio_sum, '1']
- [audio_sum, '0', audio_out, '0']
- [audio_sum, '0', upsample, '0']
- [upsample, '0', hilbert, '0']
- [hilbert, '0', mixer, '0']
- [carrier, '0', mixer, '1']
- [mixer, '0', to_real, '0']
- [to_real, '0', ssb_out, '0']
metadata: {file_format: 1}
