options:
  parameters: {id: ssb_classic_phasing, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: audio_rate
  id: variable
  parameters: {value: '8000'}
- name: fc
  id: variable
  parameters: {value: '10000'}
- name: lo_tone
  id: analog_sig_source_x
  parameters: {type: float, samp_rate: audio_rate, freq: '700', amp: '0.4'}
- name: hi_tone
  id: analog_sig_source_x
  parameters: {type: float, samp_rate: audio_rate, freq: '2400', amp: '0.25'}
- name: mix_audio
  id: blocks_add_xx
  parameters: {type: float}
- name: audio_file
  id: blocks_file_sink
  parameters: {type: float, file: audio.dat}
- name: zero_stuff
  id: interp_fir_filter_xxx
  parameters: {type: fff, interp: '6', taps: '[1.0]'}
- name: anti_image
  id: low_pass_filter
  parameters: {type: fir_filter_fff, gain: '6', cutoff_freq: '3400', width: '1200', win: window.WIN_BLACKMAN}
- name: hilb
  id: hilbert_fc
  parameters: {num_taps: '301', win: window.WIN_BLACKMAN}
- name: iq
  id: blocks_complex_to_float
  parameters: {}
- name: lo_cos
  id: analog_sig_source_x
  parameters: {type: float, freq: fc}
- name: lo_sin
  id: analog_sig_source_x
  parameters: {type: float, waveform: analog.GR_SIN_WAVE, freq: fc}
- name: i_mix
  id: blocks_multiply_xx
  parameters: {type: float}
- name: q_mix
  id: blocks_multiply_xx
  parameters: {type: float}
- name: usb
  id: blocks_sub_xx
  parameters: {type: float}
- name: ssb_file
  id: blocks_file_sink
  parameters: {type: float, file: ssb.dat}
connections:
- [lo_tone, '0', mix_audio, '0']
- [hi_tone, '0', mix_audio, '1']
- [mix_audio, '0', audio_file, '0']
- [mix_audio, '0', zero_stuff, '0']
- [zero_stuff, '0', anti_image, '0']
- [anti_image, '0', hilb, '0']
- [hilb, '0', iq, '0']
- [iq, '0', i_mix, '0']
- [lo_cos, '0', i_mix, '1']
- [iq, '1', q_mix, '0']
- [lo_sin, '0', q_mix, '1']
- [i_mix, '0', usb, '0']
- [q_mix, '0', usb, '1']
- [usb, '0', ssb_file, '0']
metadata: {file_format: 1}
