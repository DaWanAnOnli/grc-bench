options:
  parameters: {id: ssb_interp_lpf_xlating, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: audio_rate
  id: variable
  parameters: {value: '8000'}
- name: carrier
  id: variable
  parameters: {value: 10e3}
- name: low
  id: analog_sig_source_x
  parameters: {type: float, samp_rate: audio_rate, freq: '700', amp: '0.4'}
- name: high
  id: analog_sig_source_x
  parameters: {type: float, samp_rate: audio_rate, freq: '2400', amp: '0.25'}
- name: audio
  id: blocks_add_xx
  parameters: {type: float}
- name: audio_rec
  id: blocks_file_sink
  parameters: {type: float, file: audio.dat}
- name: interp_lpf
  id: low_pass_filter
  parameters: {type: interp_fir_filter_fff, interp: '6', gain: '6', cutoff_freq: '3400', width: '1000'}
- name: analytic
  id: hilbert_fc
  parameters: {num_taps: '201', win: window.WIN_BLACKMAN}
- name: up_shift
  id: freq_xlating_fir_filter_xxx
  parameters: {type: ccc, taps: '[1]', center_freq: -carrier}
- name: real_out
  id: blocks_complex_to_real
  parameters: {}
- name: ssb_rec
  id: blocks_file_sink
  parameters: {type: float, file: ssb.dat}
connections:
- [low, '0', audio, '0']
- [high, '0', audio, '1']
- [audio, '0', audio_rec, '0']
- [audio, '0', interp_lpf, '0']
- [interp_lpf, '0', analytic, '0']
- [analytic, '0', up_shift, '0']
- [up_shift, '0', real_out, '0']
- [real_out, '0', ssb_rec, '0']
metadata: {file_format: 1}
