options:
  parameters: {id: gbf_dev_24, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_7100
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '7100', amp: '0.5',
    offset: '0'}
- name: agc
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-2, reference: '1', gain: '1', max_gain: '65536'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: samp_rate, waveform: analog.GR_COS_WAVE, freq: '3500', amp: '1',
    offset: '0'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex, num_inputs: '2'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: shifted.dat, append: 'False', unbuffered: 'False', vlen: '1'}
connections:
- [agc, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', out, '0']
metadata: {file_format: 1}
