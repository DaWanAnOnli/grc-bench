options:
  parameters: {id: gbf_dev_39, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_5700
  id: analog_sig_source_x
  parameters: {type: float, freq: '5700'}
- name: tone_11400
  id: analog_sig_source_x
  parameters: {type: float, freq: '11400'}
- name: tone_9600
  id: analog_sig_source_x
  parameters: {type: float, freq: '9600', amp: '0.6'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float, num_inputs: '3'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 750/samp_rate, taps: '[1.0]'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: channel_2
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -1250/samp_rate, taps: '[1.0]'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: float, const: '0.5'}
connections:
- [tone_11400, '0', sum_of_tones, '1']
- [tone_9600, '0', sum_of_tones, '2']
- [sum_of_tones, '0', hilbert, '0']
- [hilbert, '0', channel, '0']
- [channel, '0', conj, '0']
- [conj, '0', channel_2, '0']
- [channel_2, '0', out, '0']
- [tone_5700, '0', gain, '0']
- [gain, '0', sum_of_tones, '0']
metadata: {file_format: 1}
