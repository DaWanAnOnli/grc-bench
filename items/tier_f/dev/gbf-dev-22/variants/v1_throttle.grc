options:
  parameters: {id: gbf_dev_22, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_4300
  id: analog_sig_source_x
  parameters: {type: complex, freq: '4300', amp: '0.5'}
- name: noise
  id: analog_noise_source_x
  parameters: {type: complex, amp: '0.05'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 1500/samp_rate, taps: '[1.0]'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: out_b
  id: blocks_file_sink
  parameters: {type: complex, file: second_mirrored.dat}
- name: rate_limit
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
connections:
- [tone_4300, '0', sum_of_tones, '0']
- [noise, '0', sum_of_tones, '1']
- [sum_of_tones, '0', channel, '0']
- [channel, '0', out, '0']
- [sum_of_tones, '0', conj, '0']
- [conj, '0', rate_limit, '0']
- [rate_limit, '0', out_b, '0']
metadata: {file_format: 1}
