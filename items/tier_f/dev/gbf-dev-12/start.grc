options:
  parameters: {id: gbf_dev_12, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_9300
  id: analog_sig_source_x
  parameters: {type: float, freq: '9300', amp: '0.8'}
- name: tone_1000
  id: analog_sig_source_x
  parameters: {type: float, amp: '0.5'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float}
- name: hpf
  id: high_pass_filter
  parameters: {type: fir_filter_fff, cutoff_freq: '5150', width: '300'}
- name: fm_mod
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: 2*math.pi*2500/samp_rate}
- name: fm_demod
  id: analog_quadrature_demod_cf
  parameters: {gain: samp_rate/(2*math.pi*2500)}
- name: fm_mod_2
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: 2*math.pi*2000/samp_rate}
- name: fm_demod_2
  id: analog_quadrature_demod_cf
  parameters: {gain: samp_rate/(2*math.pi*2000)}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: recovered.dat}
connections:
- [tone_9300, '0', sum_of_tones, '0']
- [tone_1000, '0', sum_of_tones, '1']
- [sum_of_tones, '0', hpf, '0']
- [hpf, '0', fm_mod, '0']
- [fm_mod, '0', fm_demod, '0']
- [fm_demod, '0', fm_mod_2, '0']
- [fm_mod_2, '0', fm_demod_2, '0']
- [fm_demod_2, '0', out, '0']
metadata: {file_format: 1}
