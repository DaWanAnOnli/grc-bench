options:
  parameters: {id: gbf_dev_11, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_5400
  id: analog_sig_source_x
  parameters: {type: float, freq: '5400', showports: 'True'}
- name: fm_mod
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: 2*math.pi*2500/samp_rate}
- name: fm_demod
  id: analog_quadrature_demod_cf
  parameters: {gain: samp_rate/(2*math.pi*2500)}
- name: fm_mod_2
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: 2*math.pi*2500/samp_rate}
- name: fm_demod_2
  id: analog_quadrature_demod_cf
  parameters: {gain: samp_rate/(2*math.pi*1250)}
- name: to_short
  id: blocks_float_to_short
  parameters: {scale: '100'}
- name: to_float
  id: blocks_short_to_float
  parameters: {scale: '100'}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 7600})', period: '200'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: float, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: quantized.dat}
- name: fm_mod_3
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: 2*math.pi*2000/samp_rate}
- name: fm_demod_3
  id: analog_quadrature_demod_cf
  parameters: {gain: samp_rate/(2*math.pi*2000)}
- name: out_b
  id: blocks_file_sink
  parameters: {type: float, file: second_recovered.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: float, const: '0.25'}
connections:
- [fm_mod, '0', fm_demod, '0']
- [fm_demod, '0', fm_mod_2, '0']
- [fm_mod_2, '0', fm_demod_2, '0']
- [fm_demod_2, '0', to_short, '0']
- [to_short, '0', to_float, '0']
- [retune, strobe, tone_5400, cmd]
- [throttle, '0', fm_mod, '0']
- [to_float, '0', out, '0']
- [fm_mod_3, '0', fm_demod_3, '0']
- [fm_demod_3, '0', out_b, '0']
- [tone_5400, '0', gain, '0']
- [gain, '0', throttle, '0']
- [gain, '0', fm_mod_3, '0']
metadata: {file_format: 1}
