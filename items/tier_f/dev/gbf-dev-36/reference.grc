options:
  parameters: {id: gbf_dev_36, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_5700
  id: analog_sig_source_x
  parameters: {type: complex, freq: '5700', amp: '0.6', showports: 'True'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '1750'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: magnitude
  id: blocks_complex_to_mag
  parameters: {}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 4000})', period: '100'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: level.dat}
- name: lo_2
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-6000'}
- name: mixer_2
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: out_b
  id: blocks_file_sink
  parameters: {type: complex, file: second_shifted.dat}
connections:
- [lo, '0', mixer, '1']
- [mixer, '0', magnitude, '0']
- [retune, strobe, tone_5700, cmd]
- [tone_5700, '0', throttle, '0']
- [throttle, '0', mixer, '0']
- [magnitude, '0', out, '0']
- [tone_5700, '0', mixer_2, '0']
- [lo_2, '0', mixer_2, '1']
- [mixer_2, '0', out_b, '0']
metadata: {file_format: 1}
