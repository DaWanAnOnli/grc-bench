options:
  parameters: {id: gbf_dev_43, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_13000
  id: analog_sig_source_x
  parameters: {type: float, freq: '13000', amp: '0.5'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat}
- name: agc
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-2, reference: '0.5', gain: '1'}
- name: out_b
  id: blocks_file_sink
  parameters: {type: complex, file: second_levelled.dat}
- name: rate_limit
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
connections:
- [tone_13000, '0', hilbert, '0']
- [hilbert, '0', conj, '0']
- [conj, '0', out, '0']
- [conj, '0', agc, '0']
- [agc, '0', rate_limit, '0']
- [rate_limit, '0', out_b, '0']
metadata: {file_format: 1}
