options:
  parameters: {id: gbf_dev_30, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_7300
  id: analog_sig_source_x
  parameters: {type: complex, freq: '7300', amp: '0.4'}
- name: tone_9500
  id: analog_sig_source_x
  parameters: {type: complex, freq: '9500', amp: '0.5'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '3000'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 2000/samp_rate, taps: '[1.0]'}
- name: channel_2
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 1000/samp_rate, taps: '[1.0]'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
connections:
- [tone_7300, '0', sum_of_tones, '0']
- [tone_9500, '0', sum_of_tones, '1']
- [sum_of_tones, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', channel, '0']
- [channel, '0', channel_2, '0']
- [channel_2, '0', out, '0']
metadata: {file_format: 1}
