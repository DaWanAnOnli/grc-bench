options:
  parameters: {id: gbf_dev_37, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_4900
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-4900', amp: '0.5', showports: 'True'}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '2'}
- name: power
  id: blocks_complex_to_mag_squared
  parameters: {}
- name: average
  id: blocks_moving_average_xx
  parameters: {type: float, length: '500', scale: 1/500}
- name: to_db
  id: blocks_nlog10_ff
  parameters: {n: '10'}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': -7800})', period: '200'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: power_db.dat}
connections:
- [resampler, '0', power, '0']
- [power, '0', average, '0']
- [average, '0', to_db, '0']
- [retune, strobe, tone_4900, cmd]
- [tone_4900, '0', throttle, '0']
- [throttle, '0', resampler, '0']
- [to_db, '0', out, '0']
metadata: {file_format: 1}
