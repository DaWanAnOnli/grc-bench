options:
  parameters: {id: gbf_dev_31, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_6200
  id: analog_sig_source_x
  parameters: {type: float, freq: '6200'}
- name: tone_4600
  id: analog_sig_source_x
  parameters: {type: float, freq: '4600', amp: '0.4'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float}
- name: hpf
  id: high_pass_filter
  parameters: {type: fir_filter_fff, cutoff_freq: '5400', width: '200'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: agc
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-2, reference: '2.000000e+00', gain: '1'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-7250'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: shifted.dat}
connections:
- [tone_6200, '0', sum_of_tones, '0']
- [tone_4600, '0', sum_of_tones, '1']
- [sum_of_tones, '0', hpf, '0']
- [hpf, '0', hilbert, '0']
- [hilbert, '0', agc, '0']
- [agc, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', out, '0']
metadata: {file_format: 1}
