options:
  parameters: {id: gbf_dev_29, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_1700
  id: analog_sig_source_x
  parameters: {type: float, freq: '1700', amp: '0.25', showports: 'True'}
- name: fm_mod
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: 2*math.pi*2500/samp_rate}
- name: fm_demod
  id: analog_quadrature_demod_cf
  parameters: {gain: samp_rate/(2*math.pi*5000)}
- name: fm_mod_2
  id: analog_frequency_modulator_fc
  parameters: {sensitivity: 2*math.pi*1000/samp_rate}
- name: fm_demod_2
  id: analog_quadrature_demod_cf
  parameters: {gain: (samp_rate/(2*math.pi*1000))}
- name: rectifier
  id: blocks_abs_xx
  parameters: {type: float}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 2400})', period: '100'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: float, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: rectified.dat}
connections:
- [fm_mod, '0', fm_demod, '0']
- [fm_demod, '0', fm_mod_2, '0']
- [fm_mod_2, '0', fm_demod_2, '0']
- [fm_demod_2, '0', rectifier, '0']
- [retune, strobe, tone_1700, cmd]
- [tone_1700, '0', throttle, '0']
- [throttle, '0', fm_mod, '0']
- [rectifier, '0', out, '0']
metadata: {file_format: 1}
