options:
  parameters: {id: gbf_dev_19, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_6500
  id: analog_sig_source_x
  parameters: {type: complex, freq: '6500'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-3250'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 2500/samp_rate, taps: '[1.0]'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: received.dat}
- name: agc
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-2, reference: '2', gain: '1'}
- name: out_b
  id: blocks_file_sink
  parameters: {type: complex, file: second_levelled.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: complex, const: '0.5'}
connections:
- [lo, '0', mixer, '1']
- [mixer, '0', channel, '0']
- [channel, '0', out, '0']
- [agc, '0', out_b, '0']
- [tone_6500, '0', gain, '0']
- [gain, '0', mixer, '0']
- [gain, '0', agc, '0']
metadata: {file_format: 1}
