options:
  parameters: {id: gbf_dev_32, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_3600
  id: analog_sig_source_x
  parameters: {type: complex, freq: '3600', amp: '0.8'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -1000/samp_rate, taps: '[1.0]'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat}
connections:
- [tone_3600, '0', channel, '0']
- [channel, '0', conj, '0']
- [conj, '0', out, '0']
metadata: {file_format: 1}
