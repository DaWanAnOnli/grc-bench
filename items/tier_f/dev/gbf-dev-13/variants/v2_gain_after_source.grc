options:
  parameters: {id: gbf_dev_13, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_9000
  id: analog_sig_source_x
  parameters: {type: complex, freq: '9000'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-2750'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: shifted.dat}
- name: magnitude
  id: blocks_complex_to_mag
  parameters: {}
- name: out_b
  id: blocks_file_sink
  parameters: {type: float, file: second_level.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: complex, const: '0.4'}
connections:
- [lo, '0', mixer, '1']
- [mixer, '0', out, '0']
- [magnitude, '0', out_b, '0']
- [tone_9000, '0', gain, '0']
- [gain, '0', mixer, '0']
- [gain, '0', magnitude, '0']
metadata: {file_format: 1}
