options:
  parameters: {id: gbf_dev_13, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_9000
  id: analog_sig_source_x
  parameters: {type: complex, freq: '9000', amp: '0.4'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-2750'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: shifted.dat}
connections:
- [tone_9000, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', out, '0']
metadata: {file_format: 1}
