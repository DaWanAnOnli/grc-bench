options:
  parameters: {id: gbf_dev_47, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_1
  id: analog_sig_source_x
  parameters: {type: complex, freq: '4000', amp: '0.4'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 1250/samp_rate, taps: '[1.0]'}
- name: channel_2
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: 1000/samp_rate, taps: '[1.0]'}
- name: channel_3
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -3000/samp_rate, taps: '[1.0]'}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '3', decim: '2'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: resampled.dat}
- name: rate_limit
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
connections:
- [tone_1, '0', channel, '0']
- [channel, '0', channel_2, '0']
- [channel_2, '0', channel_3, '0']
- [channel_3, '0', resampler, '0']
- [resampler, '0', rate_limit, '0']
- [rate_limit, '0', out, '0']
metadata: {file_format: 1}
