options:
  parameters: {id: gbf_dev_25, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_13300
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-13300', amp: '0.8'}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-5000'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: agc
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-2, reference: (0.5)*2, gain: '1'}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: levelled.dat}
connections:
- [tone_13300, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', agc, '0']
- [agc, '0', out, '0']
metadata: {file_format: 1}
