options:
  parameters: {id: gbf_dev_27, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_9500
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-9500', amp: '0.5', showports: 'True'}
- name: agc
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-2, reference: '2', gain: '1'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -2250/samp_rate, taps: '[1.0]'}
- name: agc_2
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-2, reference: '2', gain: '1'}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': -13300})', period: '250'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: levelled.dat}
- name: lo
  id: analog_sig_source_x
  parameters: {type: complex, freq: '3000'}
- name: mixer
  id: blocks_multiply_xx
  parameters: {type: complex}
- name: out_b
  id: blocks_file_sink
  parameters: {type: complex, file: second_shifted.dat}
connections:
- [agc, '0', channel, '0']
- [channel, '0', agc_2, '0']
- [retune, strobe, tone_9500, cmd]
- [tone_9500, '0', throttle, '0']
- [throttle, '0', agc, '0']
- [agc_2, '0', out, '0']
- [agc, '0', mixer, '0']
- [lo, '0', mixer, '1']
- [mixer, '0', out_b, '0']
metadata: {file_format: 1}
