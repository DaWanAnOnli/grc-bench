options:
  parameters: {id: gbf_dev_16, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '32000'}
- name: tone_2700
  id: analog_sig_source_x
  parameters: {type: float, freq: '2700', amp: '0.25', showports: 'True'}
- name: hilbert
  id: hilbert_fc
  parameters: {}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '3', decim: '2'}
- name: resampler_2
  id: rational_resampler_xxx
  parameters: {type: ccc, interp: '2', decim: '3'}
- name: retune
  id: blocks_message_strobe
  parameters: {msg: 'pmt.to_pmt({''freq'': 4300})', period: '250'}
- name: throttle
  id: blocks_throttle2
  parameters: {type: float, limit: auto}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: resampled.dat}
- name: agc
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-2, reference: '2', gain: '1'}
- name: out_b
  id: blocks_file_sink
  parameters: {type: complex, file: second_levelled.dat}
- name: rate_limit
  id: blocks_throttle2
  parameters: {type: complex, limit: auto}
connections:
- [hilbert, '0', resampler, '0']
- [resampler, '0', resampler_2, '0']
- [retune, strobe, tone_2700, cmd]
- [tone_2700, '0', throttle, '0']
- [throttle, '0', hilbert, '0']
- [resampler_2, '0', out, '0']
- [hilbert, '0', agc, '0']
- [agc, '0', rate_limit, '0']
- [rate_limit, '0', out_b, '0']
metadata: {file_format: 1}
