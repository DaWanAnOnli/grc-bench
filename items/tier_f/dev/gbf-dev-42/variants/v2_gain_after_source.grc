options:
  parameters: {id: gbf_dev_42, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_8500
  id: analog_sig_source_x
  parameters: {type: complex, freq: '8500'}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -1000/samp_rate, taps: '[1.0]'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat}
- name: gain
  id: blocks_multiply_const_vxx
  parameters: {type: complex, const: '0.25'}
connections:
- [channel, '0', conj, '0']
- [conj, '0', out, '0']
- [tone_8500, '0', gain, '0']
- [gain, '0', channel, '0']
metadata: {file_format: 1}
