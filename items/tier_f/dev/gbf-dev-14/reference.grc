options:
  parameters: {id: gbf_dev_14, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_1400
  id: analog_sig_source_x
  parameters: {type: complex, freq: '-1400', amp: '0.4'}
- name: tone_3200
  id: analog_sig_source_x
  parameters: {type: complex, freq: '3200', amp: '0.4'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: complex}
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: '0', freq_offset: -750/samp_rate, taps: '[1.0]'}
- name: conj
  id: blocks_conjugate_cc
  parameters: {}
- name: out
  id: blocks_file_sink
  parameters: {type: complex, file: mirrored.dat}
connections:
- [tone_1400, '0', sum_of_tones, '0']
- [tone_3200, '0', sum_of_tones, '1']
- [sum_of_tones, '0', channel, '0']
- [channel, '0', conj, '0']
- [conj, '0', out, '0']
metadata: {file_format: 1}
