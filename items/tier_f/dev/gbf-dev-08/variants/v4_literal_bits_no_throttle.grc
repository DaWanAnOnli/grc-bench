options:
  parameters: {id: demo_quantization, generate_options: no_gui, output_language: python}
blocks:
- name: bits
  id: variable
  parameters: {value: '6'}
- name: bw
  id: variable
  parameters: {value: samp_rate/4}
- name: center
  id: variable
  parameters: {value: samp_rate/4}
- name: noise_amp
  id: variable
  parameters: {value: '-20'}
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: sigfreq
  id: variable
  parameters: {value: '12600'}
- name: signal_amp
  id: variable
  parameters: {value: '-10'}
- name: analog_noise_source_x_0
  id: analog_noise_source_x
  parameters: {amp: 'pow(10.0,noise_amp/20.0)', seed: '7', type: float}
- name: analog_sig_source_x_0
  id: analog_sig_source_x
  parameters: {amp: 'pow(10.0,signal_amp/20.0)', freq: sigfreq, type: float}
- name: band_pass_filter_0
  id: band_pass_filter
  parameters: {high_cutoff_freq: 'min(samp_rate/2.0-bw/15.0,center+bw/2.0)', low_cutoff_freq: 'max(bw/15.0,center-bw/2.0)',
    type: fir_filter_fff, width: bw/5.0, win: window.WIN_HANN}
- name: blocks_add_xx_0
  id: blocks_add_xx
  parameters: {type: float}
- name: blocks_multiply_const_vxx_0
  id: blocks_multiply_const_vxx
  parameters: {const: '32', type: float}
- name: quantizer
  id: channels_quantizer
  parameters: {bits: '6'}
- name: import_0
  id: import
  parameters: {imports: import math}
- name: quantized_sink
  id: blocks_file_sink
  parameters: {file: quantized.dat, type: float}
- name: codes_sink
  id: blocks_file_sink
  parameters: {file: codes.dat, type: float}
connections:
- [analog_noise_source_x_0, '0', band_pass_filter_0, '0']
- [analog_sig_source_x_0, '0', blocks_add_xx_0, '1']
- [band_pass_filter_0, '0', blocks_add_xx_0, '0']
- [blocks_multiply_const_vxx_0, '0', codes_sink, '0']
- [quantizer, '0', blocks_multiply_const_vxx_0, '0']
- [quantizer, '0', quantized_sink, '0']
- [blocks_add_xx_0, '0', quantizer, '0']
metadata: {file_format: 1}
