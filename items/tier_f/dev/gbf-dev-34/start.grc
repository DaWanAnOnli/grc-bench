options:
  parameters: {id: gbf_dev_34, generate_options: no_gui, output_language: python}
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '48000'}
- name: tone_9500
  id: analog_sig_source_x
  parameters: {type: float, freq: '9500'}
- name: tone_4200
  id: analog_sig_source_x
  parameters: {type: float, freq: '5500', amp: '0.4'}
- name: tone_11200
  id: analog_sig_source_x
  parameters: {type: float, freq: '11200', amp: '0.6'}
- name: sum_of_tones
  id: blocks_add_xx
  parameters: {type: float, num_inputs: '3'}
- name: resampler
  id: rational_resampler_xxx
  parameters: {type: fff, interp: '2'}
- name: to_short
  id: blocks_float_to_short
  parameters: {scale: '100'}
- name: to_float
  id: blocks_short_to_float
  parameters: {scale: '100'}
- name: out
  id: blocks_file_sink
  parameters: {type: float, file: quantized.dat}
connections:
- [tone_9500, '0', sum_of_tones, '0']
- [tone_4200, '0', sum_of_tones, '1']
- [tone_11200, '0', sum_of_tones, '2']
- [sum_of_tones, '0', resampler, '0']
- [resampler, '0', to_short, '0']
- [to_short, '0', to_float, '0']
- [to_float, '0', out, '0']
metadata: {file_format: 1}
